function Dungeon.gateDeadline(info,now,balance)
    local config=balance and balance.Dungeon or {}
    local interval=tonumber(config.OpenTime)or 900
    local duration=tonumber(config.Duration)or 840
    local id=tonumber(info and info.ID)
    if not id or interval<=0 then return end
    local born=id*interval
    if born>now+5 or now-born>interval*2 then return end
    return born+duration
end
function Dungeon.canAfford(balance,price)
    if tonumber(price)==0 then return true end
    local function key(value)
        if type(value)=="table"then
            local k=Catalog.healthKey(value.first)local e=tonumber(value.second)
            if k and e then return {k[1]+e,k[2]}end
            return
        end
        return Catalog.healthKey(value)
    end
    local cost=key(price)
    return cost~=nil and Catalog.compareHealthKeys(key(balance),cost)>=0
end
