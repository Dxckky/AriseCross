local Catalog=(function()
-- Pure catalog helpers. Island membership comes from its quest chain, not World alone.
local Catalog = {}

local function sameWorld(value, expected)
    local number = tonumber(value)
    return number ~= nil and number == tonumber(expected)
end

local function modelFor(info, enemyInfo, seen)
    if type(info) ~= "table" then return nil end
    if info.Model ~= nil then return info.Model end
    local base = info.BaseInfo
    if type(base) ~= "string" or seen[base] then return nil end
    seen[base] = true
    return modelFor(enemyInfo[base], enemyInfo, seen)
end

local function addQuestEnemies(island, map, enemyInfo, quests)
    local key, seen = map.WorldQuest, {}
    while type(key) == "string" and not seen[key] do
        seen[key] = true
        local quest = quests[key]
        if type(quest) ~= "table" then break end
        local goals = type(quest.Goals) == "table" and quest.Goals or {}
        -- Any spawn boundary ends this island's chain, including another island's.
        local boundary = false
        for goal in pairs(goals) do
            if type(goal) == "string" and goal:match("^Spawn") then
                boundary = true
                break
            end
        end
        if boundary then break end
        for goal in pairs(goals) do
            local id = type(goal) == "string" and goal:match("^(.+)Defeated$")
            local info = id and enemyInfo[id]
            if type(info) == "table" and sameWorld(info.World, island.order)
                and info.TypeC == "Normal" and info.TypeG == nil then
                island.ids[id] = true
            end
        end
        key = quest.NeedQuest
    end
end

local function matchesModel(info, models, enemyInfo, seen)
    if type(info) ~= "table" then return false end
    if info.Model ~= nil and models[info.Model] then return true end
    local base = info.BaseInfo
    if type(base) ~= "string" or seen[base] then return false end
    seen[base] = true
    return matchesModel(enemyInfo[base], models, enemyInfo, seen)
end

local function addBrutes(island, enemyInfo)
    local models = {}
    for id in pairs(island.ids) do
        local model = modelFor(enemyInfo[id], enemyInfo, {})
        if model ~= nil then models[model] = true end
    end
    for id, info in pairs(enemyInfo) do
        if type(id) == "string" and type(info) == "table"
            and info.TypeC == "Normal" and info.TypeG == "BrutesDefeated"
            and sameWorld(info.World, island.order) then
            -- Prefer the own model; BaseInfo can resolve inherited brute variants.
            if matchesModel(info, models, enemyInfo, {}) then island.ids[id] = true end
        end
    end
end

local function buildLabels(island, enemyInfo)
    local counts = {}
    for id in pairs(island.ids) do
        local name = enemyInfo[id].Name
        name = type(name) == "string" and name ~= "" and name or id
        counts[name] = (counts[name] or 0) + 1
        table.insert(island.monsters, {id = id, name = name})
    end
    for _, monster in ipairs(island.monsters) do
        monster.label = counts[monster.name] > 1
            and (monster.name .. " [" .. monster.id .. "]") or monster.name
        island.byLabel[monster.label] = monster
    end
    table.sort(island.monsters, function(a, b)
        local left, right = a.name:lower(), b.name:lower()
        if left == right then return a.id < b.id end
        return left < right
    end)
end

function Catalog.build(mapInfo, enemyInfo, questsInfo, worldNumber)
    local catalog = {islands = {}, byKey = {}, byName = {}, byMapId = {}}
    local quests = type(questsInfo) == "table" and questsInfo.Normal
    quests = type(quests) == "table" and quests or {}
    for key, map in pairs(mapInfo) do
        local order = type(map) == "table" and tonumber(map.Order)
        if type(key) == "string" and order and order > 0 and order < math.huge
            and sameWorld(map.World, worldNumber) then
            local island = {
                key = key, name = type(map.Name) == "string" and map.Name or key,
                mapId = tostring(order), order = order,
                ids = {}, monsters = {}, byLabel = {},
            }
            addQuestEnemies(island, map, enemyInfo, quests)
            addBrutes(island, enemyInfo)
            buildLabels(island, enemyInfo)
            table.insert(catalog.islands, island)
            catalog.byKey[key] = island
            catalog.byName[island.name] = island
            catalog.byMapId[island.mapId] = island
        end
    end
    table.sort(catalog.islands, function(a, b)
        if a.order == b.order then return a.key < b.key end
        return a.order < b.order
    end)
    return catalog
end

-- Compare scientific HP without overflowing different large values to the same +inf.
function Catalog.healthKey(value)
    if type(value)~="number"and type(value)~="string"then return end
    if value==math.huge then return {math.huge,"1"}end
    local text=tostring(value):match("^%s*(.-)%s*$")
    local mantissa,exponent=text:match("^%+?([%d%.]+)[eE]([%+%-]?%d+)$")
    if not mantissa then mantissa=text:match("^%+?([%d%.]+)$")exponent="0"end
    if not mantissa then return end
    local integer,fraction=mantissa:match("^(%d*)%.(%d*)$")
    if not integer then integer=mantissa:match("^(%d+)$")fraction=""end
    if not integer then return end
    local digits=integer..fraction
    local first=digits:find("[1-9]")
    local exp=tonumber(exponent)
    if not first or not exp or exp~=exp then return end
    return {exp+#integer-first,(digits:sub(first):gsub("0+$",""))}
end
function Catalog.compareHealthKeys(a,b)
    if not a then return b and -1 or 0 end
    if not b then return 1 end
    if a[1]~=b[1]then return a[1]>b[1]and 1 or -1 end
    local length=math.max(#a[2],#b[2])
    local left=a[2]..string.rep("0",length-#a[2])
    local right=b[2]..string.rep("0",length-#b[2])
    return left==right and 0 or left>right and 1 or -1
end
function Catalog.matches(island,selected,attrs)
    if type(island)~="table"or type(attrs)~="table"then return false end
    local id=attrs.Id or attrs.ID
    local chosen=type(selected)=="table"and selected[id]==true or type(selected)=="string"and selected==id
    if not chosen or not island.ids[id]or tostring(attrs.MapId)~=island.mapId
        or attrs.Dead==true or attrs.Shield==true then return false end
    return Catalog.healthKey(attrs.HP)~=nil
end

return Catalog
end)()

