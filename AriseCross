    elseif rs:GetAttribute("InInfinite") == true then inside = self.desert
    elseif rs:GetAttribute("IsTest") == true then inside = self.hunterTest
    elseif self.dungeon and self.dungeon:inDungeon() then inside = self.dungeon end
