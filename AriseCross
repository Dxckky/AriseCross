function Dungeon:cancelPending()
    local pending=self.pending
    if not pending then return end
    pending.cancelled=true
    if pending.created and not self:inDungeon()then
        self.general:Fire({Event="DungeonAction",Action="Leave",Dungeon=self.adapter.player.UserId})
    end
    -- Retain an unacknowledged create intent so a late own-party reply can be left safely.
    if pending.created or not pending.createSent then self.pending=nil end
end
function Dungeon:connect()
    local connection=self.events:Connect(function(message)
        if not self.alive or type(message)~="table" then return end
        if message.Event=="UpdateTimer" and type(message.TimeLeft)=="number"then self.timeLeft=message.TimeLeft end
        if message.Event=="UpdateLabel" and type(message.Message)=="string"then
            local text=message.Message:lower()
            if not text:find("fail",1,true)and not text:find("not ",1,true)
                and(text:find("dungeon completed",1,true)or text:find("dungeon cleared",1,true))then self.winSignal=true end
        end
        local pending=self.pending
        if not pending then return end
        local info=message.DungeonInfo
        if message.Event=="CreatedInstance" and type(info)=="table"
            and sameId(info.Leader,self.adapter.player.UserId) and pending.createSent then
            if not sameId(info.DungeonID,pending.id)then
                pending.cancelled=true
                self.general:Fire({Event="DungeonAction",Action="Leave",Dungeon=self.adapter.player.UserId})
                self.pending=nil self:release()self.status="Server selected another dungeon; entry cancelled"return
            end
            pending.created=true
            if pending.cancelled or not self:wantsEntry() or pending.generation~=self.generation then
                self.general:Fire({Event="DungeonAction",Action="Leave",Dungeon=self.adapter.player.UserId})
                self.pending=nil
            end
        elseif message.Event=="StartedInstance" and pending.created and type(info)=="table"
            and sameId(info.Leader,self.adapter.player.UserId) then
            self.attempts[tostring(pending.id)]=nil
            pending.stage,pending.started="teleport",os.clock()
        elseif message.Event=="NotTp" then
            pending.stage,pending.started="lobby",nil
            self.nextAction=os.clock()+5
            self.status="Teleport failed; waiting before retry"
        end
    end)
    table.insert(self.connections,connection)
    table.insert(self.connections,self.adapter.player.OnTeleport:Connect(function(state)
        local name=state.Name
        if name=="Started" or name=="WaitingForServer" or name=="InProgress" then self.teleporting=true
        elseif name=="Failed" then self.teleporting=false end
    end))
    table.insert(self.connections,self.adapter.player.CharacterAdded:Connect(function()
        self.target=nil self.nextScan=0 self.app.movement.corrections=0
    end))
end
function Dungeon:alreadyCleared(info)
    local stats=self.adapter:getStats()
    local other=stats and stats:FindFirstChild("OtherData")
    local done=other and other:FindFirstChild("DgsCompleted")
    local world=done and done:FindFirstChild(tostring(info.World or self.adapter.rs:GetAttribute("WorldName")))
    return world and world:GetAttribute(tostring(info.ID))==true
end
function Dungeon:gateMatches(gate)
    if not isGate(gate) or gate.Parent~=self.adapter.main:FindFirstChild("__Dungeon") then return false end
    local info=gate:GetAttributes()
    return info.ID~=nil and tonumber(info.DungeonRank)~=nil and self.basic.Ranks[tonumber(info.DungeonRank)]~=nil
        and self.info[info.Dungeon]~=nil and Dungeon.matches(info,self.filters)
end
function Dungeon:chooseGate(root)
    self.replayWaitingReason=nil
    local folder=self.adapter.main:FindFirstChild("__Dungeon")
    if not folder then return nil end
    local preferred=self.replayEnabled and self.session and self.session.finished and self.session.ID
    local nearest,distance=nil,math.huge
    for _,gate in ipairs(folder:GetChildren())do
        if self:gateMatches(gate)and self:gateOpen(gate)and self:unambiguousGate(gate)then
            local cleared=self:alreadyCleared(gate:GetAttributes())
            if cleared and self.replayEnabled and not self:canReplayGate(gate)then
                self.replayWaitingReason=self.paymentBlocked[tostring(gate:GetAttribute("ID"))]
                    and "Replay payment not confirmed - waiting for the next dungeon"
                    or "Not enough "..(self.replayCurrency=="Ticket"and "Tickets"or "Gems").." for replay"
            end
            if not cleared or self:canReplayGate(gate)then
                if preferred and sameId(gate:GetAttribute("ID"),preferred)then return gate end
                if self.joinEnabled then
                    local position=gatePosition(gate)
                    local d=position and (position-root.Position).Magnitude or math.huge
                    if d<distance then nearest,distance=gate,d end
                end
            end
        end
    end
    return nearest
end
function Dungeon:currentSessionOwned()
    if self.pending and self.pending.created and not self.pending.cancelled then return true end
    local f=self:frame()
    return self.adapter.player:GetAttribute("InDungeon")==true and f
        and sameId(f:GetAttribute("DungeonId"),self.adapter.player.UserId)
end
function Dungeon:joinStep(character,root,humanoid,now)
    if self:inDungeon()or INSTANCE_PLACES[game.PlaceId]then self:release()return false end
    local pending=self.pending
    if pending and pending.cancelled then
        if now-pending.createdAt>20 then self.pending=nil end
        self.status="Waiting for the cancelled party request"return true
    end
    if not pending then
        if self.adapter.player:GetAttribute("InDungeon")==true then self.status="Leave the existing party before Auto Join"return false end
        if now<self.nextScan then return false end
        self.nextScan=now+0.5
        local gate=self:chooseGate(root)
        if not gate then self.status=self.replayWaitingReason or "Waiting for a matching open dungeon"return false end
        local id=tostring(gate:GetAttribute("ID"))local previous=self.attempts[id]
        if previous and(previous.count>=3 or now<previous.retryAt)then self.status="Waiting before another entry attempt"return false end
        pending={gate=gate,id=gate:GetAttribute("ID"),generation=self.generation,createdAt=now,
            stage="ready",created=false,createSent=false}
        self.pending=pending self.startAttempts=0 self:claim("join")
    end
    self:claim("join")
    if not self:wantsEntry()or pending.generation~=self.generation or not self:gateMatches(pending.gate)
        or not self:gateOpen(pending.gate)or not self:unambiguousGate(pending.gate)
        or not sameId(pending.gate:GetAttribute("ID"),pending.id)then
        self:cancelPending()self:release()self.status="Dungeon changed or closed - waiting for the next match"return true
    end
    if pending.stage=="teleport"then
        self.status="Entering dungeon..."
        if now-(pending.started or now)>25 then pending.stage="ready"self.nextAction=now+5 end
        return true
    end
    self.app.movement:stop()
    local cleared=self:alreadyCleared(pending.gate:GetAttributes())
    if not pending.createSent and cleared then
        if not self.replayEnabled then self:cancelPending()self:release()return true end
        local key=tostring(pending.id)
        local payment=self.purchaseInFlight
        if self.paymentBlocked[key]then
            self:cancelPending()self:release()self.status="Replay payment not confirmed - waiting for a fresh dungeon"return true
        end
        if payment and sameId(payment.id,pending.id)then
            self.status="Waiting for replay payment confirmation"
            if now-payment.at>12 then
                self.paymentBlocked[key]=true self:cancelPending()self:release()
                self.status="Replay payment not confirmed - no repeat charge"
            end
            return true
        end
        local price=self:replayPrice(pending.gate:GetAttributes())
        if not Dungeon.canAfford(self:replayBalance(),price)then
            self:cancelPending()self:release()self.nextScan=now+3
            self.status="Not enough "..(self.replayCurrency=="Ticket"and "Tickets"or "Gems").." for replay"return true
        end
        if not self.replayEnabled or not self:gateOpen(pending.gate)or not self:gateMatches(pending.gate)then return true end
        self.purchaseInFlight={id=pending.id,currency=self.replayCurrency,at=now}
        self.general:Fire({Event="DungeonAction",Action="BuyTicket",Type=self.replayCurrency})
        self.status="Paying replay with "..(self.replayCurrency=="Ticket"and "Tickets"or "Gems")
        return true
    end
    if not cleared and self.purchaseInFlight and sameId(self.purchaseInFlight.id,pending.id)then
        self.purchaseInFlight=nil self.paymentBlocked[tostring(pending.id)]=nil
    end
    if not pending.createSent then
        if now<self.nextAction then return true end
        if not self:wantsEntry()or not self:gateMatches(pending.gate)or not self:gateOpen(pending.gate)then return true end
        local key=tostring(pending.id)local record=self.attempts[key]or {count=0}
        record.count+=1 record.retryAt=now+10 self.attempts[key]=record
        pending.createSent,pending.createdAt,pending.stage=true,now,"creating"
        self.nextAction=now+1
        self.general:Fire({Event="DungeonAction",Action="Create"})
        self.status="Creating the matching dungeon party"return true
    end
    if not pending.created then
        self.status="Waiting for verified DungeonID from the server"
        if now-pending.createdAt>8 then pending.cancelled=true self:release()end
        return true
    end
    if now<self.nextAction then return true end
    if self.startAttempts>=3 then self:cancelPending()self:release()self.status="Dungeon start not confirmed"return true end
    if not self:wantsEntry()or not self:gateMatches(pending.gate)or not self:gateOpen(pending.gate)then return true end
    self:captureSession(pending)self:prepareResume()
    self.startAttempts+=1 pending.stage,pending.started="teleport",now self.nextAction=now+5
    self.general:Fire({Event="DungeonAction",Action="Start",Dungeon=self.adapter.player.UserId})
    self.status="Starting the matching dungeon"
    return true
end

function Dungeon:aliveEnemy(enemy)
    if not enemy or enemy.Parent~=self.adapter.enemies or not enemy:IsA("BasePart") then return false end
    if enemy:GetAttribute("Dead")==true or enemy:GetAttribute("Shield")==true then return false end
    local hp=tonumber(enemy:GetAttribute("HP"))
    if not hp or hp<=0 then return false end
    local room=self.adapter.rs:GetAttribute("CurrentRoom")
    local enemyRoom=enemy:GetAttribute("Room") or enemy:GetAttribute("RoomId")
    return room==nil or enemyRoom==nil or sameId(room,enemyRoom)
end
function Dungeon:farmStep(character,root,humanoid,dt,now)
    self:claim("farm")
    local room=self.adapter.rs:GetAttribute("CurrentRoom")
    if room~=self.lastRoom then
        self.lastRoom=room
        if not self.target then self.nextEnemy=0 self.app.movement:stop()end
    end
    if self.timeLeft and self.timeLeft<=0 then
        self.app.movement:stop()self.status="Waiting for the dungeon result"return true
    end
    if self.target and not self.adapter:enemyAlive(self.target) then
        self.target=nil self.nextEnemy=0 self.app.movement:stop()self.app.movement:waitAfterEnemy(now)
    end
    if not self.target and self.app.movement:waitingForEnemy(now)then
        self.app.movement:stop()self.status="Waiting after target death"return true
    end
    if not self.target and now>=(self.nextEnemy or 0) then
        self.nextEnemy=now+0.1
        local distance=math.huge
        for _,enemy in ipairs(self.adapter.enemies:GetChildren())do
            if self:aliveEnemy(enemy) then
                local d=(enemy.Position-root.Position).Magnitude
                if d<distance then self.target,distance=enemy,d end
            end
        end
    end
    local target=self.target
    if not target then
        self.app.movement:stop()
        self.status="Room "..tostring(room or "?")..": waiting for enemies / next room"
        return true
    end
    if not self:aliveEnemy(target)then self.app.movement:stop()self.status="Waiting for the current target"return true end
    local goal=self.adapter:targetPosition(target,character,root,humanoid,now)
    if not goal then self.app.movement:stop()self.status="Waiting for the dungeon floor to load"return true end
    local arrived,message=self.app.movement:step(character,root,humanoid,goal,target.Position,
        "TP",self.app.speed,target,dt,now)
    if message then self.status=message return true end
    if not arrived then self.status="Moving to a dungeon enemy"return true end
    if not self.farmEnabled or not self:inDungeon() or not self:aliveEnemy(target) then return true end
    if self.adapter:attack(target,root,now) then self.requests+=1 end
    self.status="Room "..tostring(room or "?").." | HP "..tostring(target:GetAttribute("HP"))
    return true
end
function Dungeon:_step(dt)
    if not self.joinEnabled and not self.farmEnabled and not self.replayEnabled then self:release()return false end
    local character,root,humanoid=self.adapter:character()
    if not character then
        self.status="Waiting for your character"self:release()
        return self:inDungeon()or self.pending~=nil
    end
    local blocked=self.adapter:blocked(true)
    if blocked then self.status=blocked self:release()return false end
    if self:inDungeon()then
        self.pending=nil self.startAttempts=0
        if self:lifecycleStep(os.clock())then return true end
        if self.farmEnabled then return self:farmStep(character,root,humanoid,dt,os.clock())end
        self:release()self.status="Inside dungeon - enable Auto Farm Dungeon"return false
    end
    self.target=nil self.timeLeft=nil self.returnAt=nil self.returnAttempts=0
    self.winSignal=false self.lastRoomHadEnemies=false self.emptyFinalSince=nil
    if self.session and not self.session.finished and self:alreadyCleared(self.session)then
        self.session.finished=true self:save()
    end
    if self.session and self.session.expiresAt and self:serverNow()>=self.session.expiresAt then
        self.session=nil self:save()
    end
    if self:wantsEntry()then return self:joinStep(character,root,humanoid,os.clock())end
