            app = app, adapter = app.adapter, alive = true,
            enabled = false, noCooldown = false, interval = 0.55,
            nextDash = 0, status = "Off", sent = 0,
        }, Dash)
    end

    function Dash:restoreCooldown()
        local cooldowns = self.adapter.cooldowns
        if self.wrapper and cooldowns.Verify == self.wrapper then
            local ok = pcall(function() cooldowns.Verify = self.originalVerify end)
            if not ok then return false end
        end
        self.wrapper, self.originalVerify = nil, nil
        return true
    end

    function Dash:setNoCooldown(value)
        value = value == true
        if not value then
            self.noCooldown = false
            if not self:restoreCooldown() then self.status = "Unable to restore Dash cooldown" end
            self:sync()
            return
        end
        local cooldowns = self.adapter.cooldowns
        if self.wrapper and cooldowns.Verify == self.wrapper then
            self.noCooldown = true
            self:sync()
            return
        end
        if type(cooldowns.Verify) ~= "function" then
            self.status = "Native Dash cooldown API unavailable"
            self:sync()
            return
        end
        local original = cooldowns.Verify
        local wrapper = function(key, ...)
            if self.alive and self.noCooldown and key == "Dash" then return true end
            return original(key, ...)
        end
        local ok = pcall(function() cooldowns.Verify = wrapper end)
        if ok and cooldowns.Verify == wrapper then
            self.originalVerify, self.wrapper = original, wrapper
            self.noCooldown = true
            self.status = "Dash client cooldown removed"
        else
            self.noCooldown = false
            self.status = "Dash cooldown module is read-only in this runtime"
        end
        self:sync()
    end

    function Dash:setEnabled(value)
        self.enabled = value == true
        self.nextDash = 0
        self.status = self.enabled and "Ready: move to auto dash" or "Auto Dash off"
        self:sync()
    end

    function Dash:step(now)
        if not self.alive or not self.enabled or now < self.nextDash then return end
        self.nextDash = now + 0.1
        local app, adapter = self.app, self.adapter
        -- Native dash has a yielding animation. Do not stack it over automated warps.
        if app.eventOwner or app.movement.expected or app:isActive() or app.autoSetSpawn
            or app.halloweenRaid and app.halloweenRaid:busy()
            or app.dungeon and app.dungeon.owner
            or app.castle and app.castle.combat and app.castle.combat.owner
            or app.desert and app.desert.owns
            or app.hunterTest and app.hunterTest.enabled
            or app.mountHunt and app.mountHunt.enabled then
            self.status = "Paused while automation controls movement"
            return
        end
        local blocked = adapter:blocked(true)
        if blocked then self.status = blocked return end
        local _, root, humanoid = adapter:character()
        if not root then self.status = "Waiting for character" return end
        if humanoid.SeatPart or root:GetAttribute("Swimming") == true
            or root:FindFirstChild("DashV") or humanoid.MoveDirection.Magnitude < 0.05 then
            self.status = "Ready: move to auto dash"
            return
        end
        local assets = adapter.rs:FindFirstChild("__Assets")
        local event = assets and assets:FindFirstChild("MovimentEvent")
        if not event or not event:IsA("BindableEvent") then
            self.status = "Native MovimentEvent unavailable"
            self.nextDash = now + 2
            return
        end
        if not self.noCooldown and not adapter.cooldowns.Verify("Dash", 0.6) then return end
        self.nextDash = now + math.clamp(tonumber(self.interval) or 0.55, 0.5, 3)
        event:Fire("Dash")
        self.sent += 1
        self.status = "Auto Dash | Requests: " .. self.sent
    end

    function Dash:sync()
        if not self.Controls then return end
        self.syncing = true
        if self.Controls.Enabled:GetState() ~= self.enabled then self.Controls.Enabled:UpdateState(self.enabled) end
        if self.Controls.NoCooldown:GetState() ~= self.noCooldown then self.Controls.NoCooldown:UpdateState(self.noCooldown) end
        self.syncing = false
    end

    function Dash:mount(tab)
        local section = tab:Section({Name = "Auto Dash", Side = "Right"})
        local enabled = section:Toggle({Name = "Auto Dash", Default = false, Callback = function(value)
            if self.alive and not self.syncing then self:setEnabled(value) end
        end}, "SenzyAutoDash")
        local noCooldown = section:Toggle({Name = "Dash No CD (Client)", Default = false, Callback = function(value)
            if self.alive and not self.syncing then self:setNoCooldown(value) end
        end}, "SenzyDashNoCD")
        local interval = section:Slider({Name = "Dash Interval (s)", Minimum = 0.5, Maximum = 3,
            Default = self.interval, Precision = 2, Callback = function(value)
                self.interval = math.clamp(tonumber(value) or 0.55, 0.5, 3)
            end}, "SenzyDashInterval")
        section:Label({Text = "Move to dash. Pauses during automated travel."})
        local status = section:Label({Text = self.status})
        self.Controls = {Enabled = enabled, NoCooldown = noCooldown, Interval = interval}
        task.spawn(function()
            local last
            while self.alive and self.app.alive do
                if self.status ~= last then last = self.status pcall(status.UpdateName, status, last) end
                task.wait(0.5)
