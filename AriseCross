function Adapter:speedCatalog(flag)
    flag=flag or "IsCastle"
    local now=os.clock()
    self.speedCatalogs=self.speedCatalogs or {}
    local cached=self.speedCatalogs[flag]
    if cached and now<cached.nextRead then return cached.definitions,cached.names,cached.native end
    local definitions,names=Adapter.defaultCastleSpeeds()
    if flag=="InInfinite"then
        definitions={Normal={request=1,value=1},Faster={request=2,value=3},Fastest={request=3,value=6}}
        names={"Normal","Faster","Fastest"}
    end
    local nativeFound=false
    local ok,native=pcall(function()
        local ps=self.player:FindFirstChild("PlayerScripts")
        local scripts=ps and ps:FindFirstChild("PlayerScripts")
        local ui=scripts and scripts:FindFirstChild("NewUI")
        local module=ui and ui:FindFirstChild("Dungeon")
        if module and module:IsA("ModuleScript")then return gameCall(function()return require(module)end)end
    end)
    local read=debug and debug.getupvalues or getupvalues
    if ok and type(native)=="table"and type(read)=="function"then
        -- Read native speed definitions without running a UI action or parsing downloaded code.
        local queue={{value=native,depth=0}}local seen={}local index,visited=1,0 local profile,labels
        while index<=#queue and visited<350 and not(profile and labels)do
            local item=queue[index]index+=1
            local value,depth=item.value,item.depth
            if not seen[value]then
                visited+=1
                seen[value]=true
                if type(value)=="table"then
                    if rawget(value,"Flag")==flag
                        and type(rawget(value,"Speeds"))=="table"and type(rawget(value,"Values"))=="table"then profile=value end
                    if rawget(value,1)=="Normal"and rawget(value,2)=="Faster"then labels=value end
                end
                if depth<7 and #queue<1500 then
                    local children=value
                    if type(value)=="function"then
                        local success,upvalues=pcall(read,value)
                        children=success and upvalues or nil
                    end
                    if type(children)=="table"then
                        for key,child in pairs(children)do
                            if #queue>=1500 then break end
                            if key~="Controller"and(type(child)=="table"or type(child)=="function")then
                                table.insert(queue,{value=child,depth=depth+1})
                            end
                        end
                    end
                end
            end
        end
        if profile then
            local found,options={},{}
            for i,request in ipairs(profile.Speeds)do
                local expected=tonumber(profile.Values[i])
                request=tonumber(request)
                local label=labels and labels[i]or names[i]or("Speed "..i)
                if type(label)=="string"and label~=""and request and expected
                    and request>0 and request<math.huge and expected>0 and expected<math.huge and not found[label]then
                    found[label]={request=request,value=expected}table.insert(options,label)
                end
            end
            if #options>0 then definitions,names=found,options nativeFound=true end
        end
    end
    self.speedCatalogs[flag]={definitions=definitions,names=names,native=nativeFound,nextRead=now+30}
    return definitions,names,nativeFound
end
function Adapter:castleSpeedCatalog()
    local definitions,names,native=self:speedCatalog("IsCastle")
    self.castleSpeedNative=native return definitions,names
end
function Adapter:desertSpeedCatalog()
    return self:speedCatalog("InInfinite")
end

function Adapter:hasShadowSpace()
    local stats=self:getStats()
    local inventory=stats and stats:FindFirstChild("Inventory")
    local pets=inventory and inventory:FindFirstChild("Pets")
    if not pets then return false end
    local capacity=gameCall(function()return tonumber(self.extras.GetTotalPets(self.player))end)
    return capacity~=nil and #pets:GetChildren()<capacity
end

function Adapter:bestPetCandidates(pets,equipped,makeKey)
    return gameCall(function()
        local maximum=tonumber(self.extras.GetMaxPets(self.player))or 0
        local candidates={}
        for _,pet in ipairs(pets:GetChildren())do
            local info=self.petInfo[pet:GetAttribute("Name")]
            if info and pet:GetAttribute("InExp")~=true and pet:FindFirstChild("Stats")then
                local record=self.data.client and pet:Raw()or pet
                local damage=self.damageFunctions.GetPetDamage(self.player,info,record,nil,nil,true)
                local key=makeKey(damage)
                if key then table.insert(candidates,{id=pet.Name,damage=key,equipped=equipped[pet.Name]==true})end
            end
        end
        return candidates,math.max(0,math.floor(maximum))
    end)
end

function Adapter:character()
    local character = self.player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if root and humanoid and humanoid.Health > 0 then return character, root, humanoid end
end

function Adapter:blocked(forDungeon)
    local world = tonumber(self.rs:GetAttribute("World"))
    if not forDungeon and self.rs:GetAttribute("Dungeon") ~= true and world and world ~= self.world then return "World changed - reload this script" end
    if self.player:GetAttribute("Mounted") == true then return "Dismount before farming" end
    if self.player:GetAttribute("Teleporting") == true then return "Waiting for teleport" end
    if self.player:GetAttribute("InBossRush") or self.player:GetAttribute("InTimeTrial")
        or (not forDungeon and (self.rs:GetAttribute("Dungeon") == true or self.rs:GetAttribute("HLRaid") == true)) then return "Return to the main world" end
    local character = self.player.Character
    if character and character:GetAttribute("InTp") then return "Waiting for teleport" end
end

function Adapter:refreshStats(now)
    if now < self.nextStats then return end
    self.nextStats = now + 10
    gameCall(function()
        self.range = tonumber(self.pets:GetRange(self.player)) or 30
        local talent = self.extras.FindTalent(self.player, "AttackSpeed")
        self.interval = math.max(0.4 * (tonumber(talent) or 1), 0.1) + 0.05
    end)
end

-- Instanced enemies retain their spawn attributes; live health and death are in EnemyLocal.
function Adapter:onEnemyEvent(message)
    if type(message)~="table"then return end
    local key=message.Enemy or message.EnemyId
    local enemy=key and self.enemies:FindFirstChild(tostring(key))
    if not enemy then return end
    self.nextEnemySnapshot=0
    if message.Event=="EnemyDeath"then self.deadEnemies[enemy]=true
    elseif message.Event=="RespawnEnemy"then self.deadEnemies[enemy]=nil end
end
function Adapter:installDispatch(app)
    self.app = app
    local native = self.generalBridge
    local proxy = {}
    function proxy:Connect(callback) return native:Connect(callback) end
    function proxy:Fire(packet)
        local event, action = packet.Event, packet.Action
        local entering = event == "DungeonAction" and (action == "Create" or action == "Start" or action == "TestEnter")
            or event == "CastleAction" and action == "Join"
            or event == "InfiniteModeAction" and (action == "Create" or action == "Start")
        local exclusive = entering or event == "LeaveDungeon"
            or (event == "DungeonAction" or event == "CastleAction" or event == "InfiniteModeAction") and action == "BuyTicket"
        if exclusive then
            local owner, now = app.currentWorker or app.runtimeOwner or app, os.clock()
            local intent = app.entryIntent
            if intent and now < intent.expires and intent.owner ~= owner then return false end
            app:acquireRuntime(owner)
            app.frameDispatched = true
            if entering then app.entryIntent = {owner = owner, expires = now + 45} end
        end
        native:Fire(packet)
        return true
    end
    self.generalBridge = proxy
end
function Adapter:joinHalloween()
