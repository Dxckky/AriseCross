function Adapter:nearest(island, enemyId, position, catalogModule)
    local nearest, distance = nil, math.huge
    for _, enemy in ipairs(self:enemyList()) do
        if self:isTarget(enemy, island, enemyId, catalogModule) then
            local current = (enemy.Position - position).Magnitude
            if current < distance then nearest, distance = enemy, current end
        end
    end
    return nearest, distance
end

function Adapter:highestHealth(island,selectedIds,position,catalogModule,currentTarget,visited)
    local best,bestHP,bestDistance=nil,nil,math.huge
    for _,enemy in ipairs(self:enemyList())do
        if enemy:IsA("BasePart")then
            local attrs=self:enemyAttributes(enemy)
            if catalogModule.matches(island,selectedIds,attrs)and not(visited and visited[enemy])then
                local hp=catalogModule.healthKey(attrs.HP)
                local distance=(enemy.Position-position).Magnitude
                local compare=catalogModule.compareHealthKeys(hp,bestHP)
                if compare>0 or compare==0 and (enemy==currentTarget
                    or best~=currentTarget and distance<bestDistance)then
                    best,bestHP,bestDistance=enemy,hp,distance
                end
            end
        end
    end
    return best
end

function Adapter:randomTarget(island,selected,catalogModule,visited,choose)
    local target,count=nil,0
    for _,enemy in ipairs(self:enemyList())do
        if self:isTarget(enemy,island,selected,catalogModule)and not(visited and visited[enemy])then
            count+=1
            if(choose or math.random)(count)==1 then target=enemy end
        end
    end
    return target
end

function Adapter:armyNear(root)
    if self.player:GetAttribute("PetsArise")~=true then return true,0,0 end
    local army=gameCall(function()return self.petController.GetPlayerPets(self.player)end)
    local total,near=0,0
    local radius=math.max(12,math.min(self.range or 30,25))
    for _,pet in pairs(army or {})do
        if pet.PetFolder and pet.PetFolder.Parent and typeof(pet._currentCFrame)=="CFrame"then
            total+=1
            if(pet._currentCFrame.Position-root.Position).Magnitude<=radius then near+=1 end
        end
    end
    return total==0 or near==total,near,total
end

function Adapter:standingHeight(character, root, humanoid)
    local height = root.Size.Y * 0.5 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
        if leg and leg:IsA("BasePart") then height += leg.Size.Y end
    end
    return height
end

function Adapter:groundAt(position, rise, drop)
    local hit = workspace:Raycast(position + Vector3.new(0, rise or 2, 0),
        Vector3.new(0, -(drop or 128), 0), self.floorParams)
    if hit and hit.Normal.Y >= 0.45 then return hit.Position end
end

function Adapter:targetPosition(enemy, character, root, humanoid, now)
    if not enemy or not enemy.Parent or not enemy:IsA("BasePart")then return nil end
    if enemy and enemy.Parent==self.enemies and enemy:IsA("BasePart")then return enemy.Position end
    local cache = self.floorCache
    if cache and cache.enemy == enemy and cache.character == character and now < cache.expires
        and (cache.enemyPosition - enemy.Position).Magnitude < 1 then
        return cache.goal
    end
    local floor = self:groundAt(enemy.Position)
    local goal = floor and Vector3.new(enemy.Position.X,
        floor.Y + self:standingHeight(character, root, humanoid), enemy.Position.Z)
    self.floorCache = {enemy=enemy, character=character, enemyPosition=enemy.Position, goal=goal, expires=now+0.1}
    return goal
end

function Adapter:cacheSpawns()
    self.spawnCache=self.spawnCache or {}
    local extra=workspace:FindFirstChild("__Extra")
    self.spawns=extra and extra:FindFirstChild("__Spawns")or self.spawns
    if not self.spawns or not self.spawns.Parent then return end
    for _,spawn in ipairs(self.spawns:GetChildren())do
        if spawn:IsA("BasePart")then
            self.spawnCache[spawn.Name]={position=spawn.Position,height=spawn.Size.Y*.5}
        end
    end
end
function Adapter:spawnPosition(island, character, root, humanoid)
    local now=os.clock()
    if now>=(self.nextSpawnCache or 0)then self.nextSpawnCache=now+2 self:cacheSpawns()end
    local spawn=self.spawns and self.spawns:FindFirstChild(island.key)
    local cached=self.spawnCache and self.spawnCache[island.key]
    if spawn and spawn:IsA("BasePart")then
        cached={position=spawn.Position,height=spawn.Size.Y*.5}
        self.spawnCache=self.spawnCache or {} self.spawnCache[island.key]=cached
    end
    if not cached then return nil end
    local position=cached.position
    local floor=self:groundAt(position)
    local surfaceY=floor and floor.Y or position.Y+cached.height
    return Vector3.new(position.X,surfaceY+self:standingHeight(character,root,humanoid),position.Z)
end

function Adapter:requestArea(position,key,now)
    if typeof(position)~="Vector3"or not workspace.StreamingEnabled then return false end
    now=now or os.clock()key=tostring(key)
    self.areaRequests=self.areaRequests or {}
    if self.areaBusy or now<(self.areaNext or 0)or now-(self.areaRequests[key]or -math.huge)<8 then return false end
    local count=0 for _ in pairs(self.areaRequests)do count+=1 end
    if count>=16 then self.areaRequests={}end
    self.areaRequests[key]=now self.areaBusy=true self.areaNext=now+2
    task.spawn(function()
        pcall(function()self.player:RequestStreamAroundAsync(position,3)end)
        self.areaBusy=false
    end)
    return true
end

-- Use the same input path as the game's AutoClick script; no operating-system mouse events.
function Adapter:autoClickInput(now,lockedTarget)
    if self.nativeClickBusy or now<(self.nextNativeClick or 0)then return end
    if not self.weapons then return end
    if lockedTarget then
        local nearest=self.weapons.NearestEnemy()
        if nearest~=lockedTarget then return end
    end
    self.nextNativeClick=now+.1 self.nativeClickBusy=true
    task.spawn(function()
        local ok,err=pcall(function()
            gameCall(function()self.weapons.Click({KeyCode=Enum.KeyCode.ButtonX},false,nil,true)end)
        end)
        self.nativeClickBusy=false
        if not ok and not self.nativeClickWarned then self.nativeClickWarned=true warn("[senzy hub] Auto click input: "..tostring(err))end
    end)
end

-- Experimental request rate, independent of the native Punch cooldown. Server acceptance is authoritative.
function Adapter:instanceClick(enemy, root, now)
    if now < math.max(self.nextInstanceClick or 0, self.nextAttack or 0) then return false end
    if not self:enemyAlive(enemy) or enemy:GetAttribute("Shield") == true then return false end
    if (enemy.Position - root.Position).Magnitude > math.min(self.range or 30, 25) then return false end
    local interval = tonumber(self.fastAttackInterval) or 0.05
    if interval ~= interval then interval = 0.05 end
    interval = math.clamp(interval, 0.04, 0.15)
    self.nextInstanceClick, self.nextAttack = now + interval, now + interval
    if self.app then self.app:acquireRuntime(self.app.currentWorker) end
    self.bridge:Fire({Event = "PunchAttack", Enemy = enemy.Name})
    self.fastRequests = (self.fastRequests or 0) + 1
    return true
end

function Adapter:attack(enemy, root, now)
    if self.fastAttackEnabled then return self:instanceClick(enemy,root,now) end
    if not self:enemyAlive(enemy)or enemy:GetAttribute("Shield")==true then return false end
    if now < (self.nextAttack or 0) then return false end
    if (enemy.Position - root.Position).Magnitude > math.min(self.range, 25) then return false end
    if not self.cooldowns.Verify("Punch", self.interval) then return false end
    self.nextAttack = now + self.interval
    self.cooldowns.Add("Punch")
    self.bridge:Fire({Event = "PunchAttack", Enemy = enemy.Name})
    return true
end

return Adapter
end)()

local Movement=(function()
-- Model PivotTo warps, paced like the supplied reference. No persistent physics controller.
local Movement={}
Movement.__index=Movement
local WARP_INTERVAL=1.2
function Movement.new(adapter)
    return setmetatable({adapter=adapter,corrections=0,tpDelay=1,nextEnemyAt=0,nextWarpAt=0},Movement)
end
function Movement:stop()
    self.character,self.root,self.humanoid=nil,nil,nil
    self.expected,self.sentAt,self.key,self.landedEnemy=nil,nil,nil,nil
    -- Keep the shared warp cooldown and post-kill delay across target / owner changes.
end
function Movement:attach(character,root,humanoid)
    if self.root==root and self.character==character then return end
    self:stop()
    self.character,self.root,self.humanoid=character,root,humanoid
end
local function upright(position,lookAt,root)
    local direction=Vector3.new(lookAt.X-position.X,0,lookAt.Z-position.Z)
    if direction.Magnitude<0.05 then
        local old=root.CFrame.LookVector
        direction=Vector3.new(old.X,0,old.Z)
    end
    if direction.Magnitude<0.05 then direction=Vector3.new(0,0,-1)end
    return CFrame.lookAt(position,position+direction.Unit)
end
function Movement:waitAfterEnemy(now)
    self.nextEnemyAt=now+math.clamp(tonumber(self.tpDelay)or 1,0,10)
end
function Movement:waitingForEnemy(now)
    return now<(self.nextEnemyAt or 0)
end
function Movement:step(character,root,humanoid,goal,lookAt,mode,speed,key,dt,now)
    if self.adapter.app then self.adapter.app:acquireRuntime(self.adapter.app.currentWorker) end
    self:attach(character,root,humanoid)
    if self.corrections>=3 then return false,"Movement was reset repeatedly - farm stopped"end
    if not character.Parent or not root.Parent or humanoid.Health<=0 or root.Anchored then return false end
    local enemy=typeof(key)=="Instance"and key:IsA("BasePart")and key.Parent==self.adapter.enemies
    if enemy then
        if not self.adapter:enemyAlive(key)then return false,"Waiting for a live target"end
        goal=key.Position
    end
    if typeof(goal)~="Vector3"then return false,"Waiting for a destination"end
    local position=root.Position
    if self.expected then
        if(position-self.expected).Magnitude>60 then
            self.corrections+=1 self.expected=nil self.sentAt=nil self.landedEnemy=nil
            self.nextWarpAt=math.max(self.nextWarpAt,now+WARP_INTERVAL)
            if self.corrections>=3 then return false,"Movement was reset repeatedly - farm stopped"end
            return false,"Position changed - waiting before retry"
        elseif now-(self.sentAt or now)>=WARP_INTERVAL then self.expected=nil self.sentAt=nil end
    end
    if enemy and self.landedEnemy==key and(position-goal).Magnitude<=math.min(self.adapter.range or 30,25)then return true end
    if(position-goal).Magnitude<=0.8 then
        self.landedEnemy=enemy and key or nil
        return enemy or humanoid.FloorMaterial~=Enum.Material.Air
    end
    if enemy and self:waitingForEnemy(now)then return false,"Waiting after target death"end
    if now<self.nextWarpAt then return false end
    local destination=enemy and key.CFrame or upright(goal,lookAt or goal,root)
    -- Model pivots can differ from the root's frame. Preserve that offset so HRP lands exactly on the target.
    local rootToPivot=root.CFrame:ToObjectSpace(character:GetPivot())
    character:PivotTo(destination*rootToPivot)
    self.nextWarpAt=now+WARP_INTERVAL
    self.expected,self.sentAt,self.key=goal,now,key
    self.landedEnemy=enemy and key or nil
    return false
end
return Movement
end)()

local ShadowFollow=(function()
-- Native ShowPets transport. Never changes shadow positions or attack targets locally.
local ShadowFollow={}
ShadowFollow.__index=ShadowFollow
function ShadowFollow.new(app)
    return setmetatable({app=app,adapter=app.adapter,stage="idle",nextTry=0,lastSent=-math.huge,alive=true},ShadowFollow)
end
function ShadowFollow:busy()return self.stage~="idle"end
function ShadowFollow:send(now)
    self.lastSent=now self.adapter.shadowBridge:Fire({Event="ShowPets"})
end
function ShadowFollow:finish(now)
    self.stage="idle"self.key=nil self.character=nil self.awaitHide=false self.nextTry=now+6
end
function ShadowFollow:cancel(now)
    if self.stage=="idle"or self.stage=="recover"then return end
    self.awaitHide=self.stage=="hide"
    local sent=(self.stage=="show"or self.stage=="verify")and self.restoreSent==true
    self.stage="recover"self.deadline=now+8 self.restoreSent=sent
end
function ShadowFollow:tick(now)
    if not self.alive or self.stage=="idle"then return end
    local shown=self.adapter.player:GetAttribute("PetsArise")
    local character,root=self.adapter:character()
    if self.stage~="recover"and character~=self.character then self:cancel(now)end
    if self.stage=="hide"then
        if shown==false then self.stage="move"self.deadline=now+12
        elseif now>=self.deadline then self:cancel(now)end
    elseif self.stage=="move"then
        if now>=self.deadline then self:cancel(now)end
    elseif self.stage=="show"then
        if shown==true then self.stage="verify"self.deadline=now+4
        elseif shown==false and not self.restoreSent and now-self.lastSent>=3 then self.restoreSent=true self:send(now)
        elseif now>=self.deadline then self:cancel(now)end
    elseif self.stage=="verify"then
        if shown==false then self:cancel(now)
        elseif root then
            local ready,_,count=self.adapter:armyNear(root)
            if ready and count>0 or now>=self.deadline then self:finish(now)end
        elseif now>=self.deadline then self:finish(now)end
    elseif self.stage=="recover"then
        if shown==true and(not self.awaitHide or now-self.lastSent>=5)then self:finish(now)
        elseif shown==false and character and not self.restoreSent and now-self.lastSent>=3 then self.restoreSent=true self.awaitHide=false self:send(now)
        elseif now>=self.deadline then
            self.app:stopAll("Shadow summon was not confirmed - check ARISE")
            self:finish(now)
        end
    end
end
function ShadowFollow:beforeMove(key,character,root,goal,now)
    if self:busy()and self.key~=key then self:cancel(now)end
    self:tick(now)
    if self.stage=="hide"or self.stage=="recover"then return false,"Waiting for shadow state"end
    if self:busy()then return true end
    if now<self.nextTry or self.adapter.player:GetAttribute("PetsArise")~=true then return true end
    local ready,_,count=self.adapter:armyNear(root)
    if count==0 or ready and(root.Position-goal).Magnitude<=40 then return true end
    self.key=key self.character=character self.stage="hide"self.deadline=now+5 self.restoreSent=false
    self:send(now)
    return false,"Storing shadows before warp"
end
function ShadowFollow:afterMove(arrived,now)
    if not arrived then return false end
    if self.stage=="move"then
        self.stage="show"self.deadline=now+8 self.restoreSent=false
        self:tick(now)
    end
    return self.stage=="idle"
end
function ShadowFollow:Destroy()
    if not self.alive then return end
    local restore=self:busy()
    local wasStage=self.stage
    self.alive=false self.stage="idle"
    if not restore then return end
    local adapter=self.adapter local lastSent=self.lastSent
    local pendingHide=self.awaitHide or wasStage=="hide"
    local showSent=self.restoreSent==true
    task.spawn(function()
        local deadline=os.clock()+8
        while os.clock()<deadline do
            local current=getgenv().SenzyAriseFarm
            if current and current~=self.app and current.shadowFollow and current.shadowFollow:busy()then return end
            local shown=adapter.player:GetAttribute("PetsArise")
            if shown==true and(not pendingHide or os.clock()-lastSent>=5)then return end
            if shown==false and not showSent and os.clock()-lastSent>=3 then adapter.shadowBridge:Fire({Event="ShowPets"})return end
            task.wait(.2)
        end
    end)
end
return ShadowFollow
end)()

local Controller=(function()
-- Random coverage of selected enemies; keep the chosen living target until death or invalidation.
local Controller = {}
Controller.__index = Controller

function Controller.new(adapter, catalog, catalogModule, movement)
    return setmetatable({
        adapter=adapter, catalog=catalog, catalogModule=catalogModule, movement=movement,
        alive=true, enabled=false, autoSetSpawn=false, mode="TP", speed=100, generation=0,
        selectedIds={}, selectedCount=0, visited={}, connections={}, status="Select an island first", requests=0, nextSearch=0,
        clickEnabled=false, clickCount=0, clickStatus="Off",
    }, Controller)
end

function Controller:isActive()
    return self.enabled
end

function Controller:invalidate()
    if self.shadowFollow then self.shadowFollow:cancel(os.clock())end
    self.generation += 1
    self.target, self.nextSearch = nil, 0
    self.movement:stop()
    
end

function Controller:selectIsland(name)
    self.visited={}self.armyWaitUntil=nil
    self:invalidate()
    self.enabled = false
    self.island = self.catalog.byName[name]
    self.enemyId, self.monster = nil, nil
    self.selectedIds,self.selectedCount={},0
    self.spawnState=nil
    self.status = self.island and "Select a monster" or "Select an island first"
end

function Controller:selectMonster(labels)
    self.visited={}self.armyWaitUntil=nil
    self:invalidate()
    self.enabled=false
    self.selectedIds,self.selectedCount={},0
    self.enemyId,self.monster=nil,nil
    if type(labels)=="string"then labels={labels}end
    if self.island and type(labels)=="table"then
        for _,label in ipairs(labels)do
            local monster=self.island.byLabel[label]
            if monster and not self.selectedIds[monster.id]then
                self.selectedIds[monster.id]=true self.selectedCount+=1
                self.monster=self.monster or monster self.enemyId=self.enemyId or monster.id
            end
        end
    end
    self.status=self.selectedCount>0 and "Ready"or "Select a monster"
end
function Controller:selectionReady()
    if not self.island then return false end
    for id,active in pairs(self.selectedIds)do
        if active and self.island.ids[id]then return true end
    end
    return false
end

function Controller:updateStatus()
    if not self.island then self.status="Select an island first"
    elseif not self:selectionReady() then self.status="Select a monster"
    elseif self:isActive() then self.status="Finding the selected monster"
    else self.status="Stopped" end
end

function Controller:setEnabled(enabled)
    if enabled and self.desert then self.desert:stop("Farm selected")end
    self.visited={}self.armyWaitUntil=nil
    if enabled and self.castle then self.castle:stop("Farm selected")end
    if enabled and self.hunterTest then self.hunterTest:stop("Farm selected") end
    if enabled and self.mountHunt then self.mountHunt:setEnabled(false) end
    self:invalidate()
    self.movement.corrections = 0
    self.enabled = enabled == true and self:selectionReady()
    self:updateStatus()
    return self.enabled
end

function Controller:setAutoSpawn(enabled)
    if enabled and self.desert then self.desert:stop("Spawn setting selected")end
    self.autoSetSpawn=enabled==true
    self.spawnState=nil self:invalidate()
    if self.autoSetSpawn then
        if self.hunterTest then self.hunterTest:stop("Spawn setting selected")end
        if self.mountHunt then self.mountHunt:setEnabled(false)end
        if self.dungeon then
            self.dungeon:setJoin(false)self.dungeon:setFarm(false)
            if self.dungeon.onStopped then self.dungeon.onStopped()end
        end
    end
end
function Controller:spawnStep(character,root,humanoid,dt,now)
    local island=self.island
    if not island then self.status="Select an island"return false end
    local stats=self.adapter:getStats()
    if stats and stats:GetAttribute("Spawn")==island.key then self.spawnState=nil return false end
    local state=self.spawnState
    if not state or state.key~=island.key then
        state={key=island.key,attempts=0,nextTry=0}self.spawnState=state
    end
    if state.attempts>=3 then self.status="Spawn change not confirmed"return false end
    local extra=workspace:FindFirstChild("__Extra")
    local interactions=extra and extra:FindFirstChild("__Interactions")
    local spawns=interactions and interactions:FindFirstChild("Spawns")
    local entry=spawns and spawns:FindFirstChild(island.key)
    local prompt=entry and entry:FindFirstChild("SpawnPrompt",true)
    local position
    if prompt and prompt:IsA("ProximityPrompt")then
        local parent=prompt.Parent
        if parent:IsA("Attachment")then position=parent.WorldPosition
        elseif parent:IsA("BasePart")then position=parent.Position
        elseif parent:IsA("Model")then position=parent:GetPivot().Position end
    end
    local goal
    if position then
        local direction=Vector3.new(root.Position.X-position.X,0,root.Position.Z-position.Z)
        direction=direction.Magnitude>0.1 and direction.Unit or Vector3.new(0,0,1)
        local stand=position+direction*math.min(4,prompt.MaxActivationDistance*.5)
        local floor=self.adapter:groundAt(stand,4,128)
        goal=floor and Vector3.new(stand.X,floor.Y+self.adapter:standingHeight(character,root,humanoid),stand.Z)
    else goal=self.adapter:spawnPosition(island,character,root,humanoid)end
    if not goal then self.movement:stop()self.status="Waiting for island spawn"return true end
    self.status="Setting spawn: "..island.name
    local arrived,message=self.movement:step(character,root,humanoid,goal,position or goal,
        "TP",self.speed,"SetSpawn:"..island.key,dt,now)
    if message then
        if self.movement.corrections>=3 then self:stopAll(message)else self.status=message end
        return true
    end
    if not arrived or not position then return true end
    if not prompt.Enabled or(root.Position-position).Magnitude>prompt.MaxActivationDistance then return true end
    if now<state.nextTry then return true end
    if not self.autoSetSpawn or self.island~=island or not prompt.Parent then return true end
    state.attempts+=1 state.nextTry=now+3
    self.adapter.generalBridge:Fire({Event="ChangeSpawn",Spawn=island.key})
    return true
end

function Controller:setMode(mode)
    if mode ~= "TP" then return end
    if self.mode ~= mode then self:invalidate() self.mode=mode end
end

function Controller:stopAll(message,preserveEvents)
    if not preserveEvents and self.raid and self.raid.owns then self.raid:setEnabled(false)end
    if self.desert and self.desert.owns then self.desert:stop(message)end
    if not preserveEvents and self.storm and self.storm.owns then self.storm:setEnabled(false)end
    if not preserveEvents and self.worldBoss and self.worldBoss.owns then self.worldBoss:setEnabled(false)end
    self.enabled, self.autoSetSpawn = false, false
    self:invalidate()
    self.status = message or "Stopped"
    if self.onStopped then self.onStopped() end
end

function Controller:setClickEnabled(value)
    self.clickEnabled = value == true
    self.adapter.fastAttackEnabled = self.clickEnabled
    self.clickStatus = self.clickEnabled and "Fast Attack ready" or "Off"
end
function Controller:clickStep(now)
    if not self.alive or not self.clickEnabled then return end
    if self.shadowFollow and self.shadowFollow:busy()then
        self.clickStatus="Waiting for shadows"return
    end
    if self.autoSetSpawn and not self:isActive()then
        self.clickStatus="Waiting for spawn travel"return
    end
    local adapter=self.adapter
    local blocked=adapter:blocked(true)
    if blocked then self.clickStatus=blocked return end
    local _,root=adapter:character()
    if not root then self.clickStatus="Waiting for your character"return end
    adapter:refreshStats(now)
    if now<(adapter.nextAttack or 0)then return end
    local best,bestDistance=nil,math.min(adapter.range,25)
    if self:isActive()then
        -- Share the farm's locked target. Never choose another species or a corpse.
        if adapter:isTarget(self.target,self.island,self.selectedIds,self.catalogModule)then
            best=self.target
        end
        if not best then self.clickStatus="Waiting for farm target"return end
        if(best.Position-root.Position).Magnitude>bestDistance then self.clickStatus="Moving to farm target"return end
    else
        for _,enemy in ipairs(adapter:enemyList())do
            if enemy:IsA("BasePart")then
                local attrs=adapter:enemyAttributes(enemy)
                if attrs.Dead~=true and attrs.Shield~=true and self.catalogModule.healthKey(attrs.HP)then
                    local distance=(enemy.Position-root.Position).Magnitude
                    if distance<=bestDistance then best,bestDistance=enemy,distance end
                end
            end
        end
    end
    if not best then self.clickStatus="Auto clicking | Waiting for a nearby enemy"return end
    if adapter:instanceClick(best,root,now)then
        self.clickCount+=1
        self.clickStatus="Auto Click + Fast | Requests: "..self.clickCount
    else self.clickStatus="Waiting for request interval"end
end

function Controller:acquireRuntime(owner)
    owner = owner or self
    if self.runtimeOwner == owner then return end
    local old = self.runtimeOwner
    self.runtimeOwner = nil
    if old and old ~= self and type(old.release) == "function" then old:release() end
    if self.eventOwner and self.eventOwner ~= owner then
        self.eventOwner:release() self.eventOwner = nil self.eventOwnerSince = nil
    end
