                    owner=worker self.eventCursor=index
                    self.eventOwner=owner self.eventOwnerSince=now break
                end
            end
            if not owner and yielded and ready[yielded]then
                owner=yielded self.eventOwner=owner self.eventOwnerSince=now
            end
        end
        if not owner then return false end
        -- Coordinate event movement with instance entry and the ordinary farm as well.
        if self.runtimeOwner~=owner then
            self:acquireRuntime(owner)
