        local icon = main and main:FindFirstChild("BillboardGui")
        if icon and icon:IsA("BillboardGui") and not icon.Enabled then return false end
        local attempt = self.attempts[pumpkin]
        return not attempt or now >= (attempt.retryAt or 0)
    end

    function Pumpkins:islandFor(pumpkin, part)
        local id = pumpkin:GetAttribute("MapId") or pumpkin:GetAttribute("Map")
        local island = id and Storm.resolve(id, self.app.catalog)
        if island then return island end
        local best, distance
        for key, spawn in pairs(self.adapter.spawnCache or {}) do
            local candidate = self.app.catalog.byKey[key]
            if candidate then
                local delta = part.Position - spawn.position
                local d = delta.X * delta.X + delta.Z * delta.Z
                if not distance or d < distance then best, distance = candidate, d end
            end
        end
        return best
    end

    function Pumpkins:scan(now)
        if now < self.nextScan then return end
        self.nextScan = now + 0.5
        local folder = self:folder()
        local _, root = self.adapter:character()
        self.visible = 0
        if not folder or not root then self.target = nil return end
        self.adapter:cacheSpawns()
