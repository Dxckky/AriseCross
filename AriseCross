        end},"SenzyTPDelay")
    toggle = controls:Toggle({
        Name = "Auto Farm", Default = false,
        Callback = function(value)
            if not app.alive then return end
            -- Ignore stale callbacks queued by a programmatic reset.
            if toggle and toggle:GetState() ~= (value == true) then return end
            if app.enabled==(value==true)then return end
            local running = app:setEnabled(value)
            if value and not running then stopToggle() end
        end,
    }, "SenzyAriseEnabled")
    spawnToggle=controls:Toggle({Name="Auto Set Spawn",Default=false,Callback=function(value)
        if not app.alive or(spawnToggle and spawnToggle:GetState()~=(value==true))then return end
        if app.autoSetSpawn~=(value==true)then app:setAutoSpawn(value)end
    end},"SenzyAutoSetSpawn")
    app.Controls = {
        Island = islandDropdown, Monster = monsterDropdown, 
        Enabled = toggle, Spawn = spawnToggle, TPDelay = tpDelay,
    }
    if app.hunterTest then
        app.hunterTest:mount(group)
        if app.companions then app.companions:mount(app.hunterTest.tab)end
        if app.defeat then app.defeat:mount(app.hunterTest.tab)end
    end
    restoreUIContext()
    if app.worldBoss then app.worldBoss:mount(tab)end
    if app.storm then app.storm:mount(tab)end
    if app.mountHunt then app.mountHunt:mount(tab) end
    if app.dungeon then app.dungeon:mount(group) end
    if app.raid then
        app.raid:mount(group)
        if app.castle then app.castle:mount(app.raid.tab)end
        restoreUIContext()
        if app.desert then app.desert:mount(app.raid.tab)end
    end
    -- Reassert the executor UI context after native game-module reads during Castle mount.
    restoreUIContext()
    if app.halloweenRaid then
        local halloween=group:Tab({Name="Halloween"})
        app.halloweenRaid:mount(halloween)
        app.pumpkins:mount(halloween)
    end
    if app.sell then app.sell:mount(group)end
    if app.server then app.server:mount(group)end
    restoreUIContext()
    local misc=group:Tab({Name="Misc"})
    local runtime=misc:Section({Name="Task Coordinator",Side="Left"})
    runtime:Label({Text="One movement owner, one attack budget, one pending instance entry."})
    local runtimeLabel=runtime:Label({Text="Active: Idle"})
    task.spawn(function()
        local last
        while app.alive do
            local owner=app.runtimeOwner
            local text="Active: "..(owner and(owner.eventName or owner.runtimeName or "Farm / Misc")or "Idle")
            if text~=last then last=text pcall(runtimeLabel.UpdateName,runtimeLabel,text)end
            task.wait(0.5)
        end
    end)
    local clickSection=misc:Section({Name="Instance Click",Side="Left"})
    local clickToggle
    clickToggle=clickSection:Toggle({
        Name="Auto Click + Fast Attack",Default=false,
        Callback=function(value)
            if not app.alive or (clickToggle and clickToggle:GetState()~=(value==true))then return end
            app:setClickEnabled(value)
        end,
    },"SenzyInstanceClick")
    local fastInterval=clickSection:Slider({Name="Attack Request Interval (s)",Minimum=0.04,Maximum=0.15,
        Default=0.05,Precision=2,Callback=function(value)
            local interval=tonumber(value)or 0.05
            if interval==interval then app.adapter.fastAttackInterval=math.clamp(interval,0.04,0.15)end
        end},"SenzyFastAttackInterval")
    app.Controls.FastInterval=fastInterval
    clickSection:Label({Text="0.05s = up to 20 requests/s; server decides accepted hits."})
    local clickLabel=clickSection:Label({Text=app.clickStatus})
    app.onClickStopped=function()
        if clickToggle and clickToggle:GetState()then clickToggle:UpdateState(false)end
    end
    app.Controls.MiscClick=clickToggle
    if app.wheel then app.wheel:mount(misc)end
    if app.dash then app.dash:mount(misc)end
    task.spawn(function()
        local last=nil
        while app.alive do
            local current=app.clickStatus
            if current~=last then last=current pcall(clickLabel.UpdateName,clickLabel,current)end
            task.wait(0.25)
        end
    end)
    window.onUnloaded(function() app:Destroy() end)
    restoreUIContext()
    tab:Select()
end

return UI
end)()

