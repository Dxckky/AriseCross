        local looting=owner.corpses and next(owner.corpses)~=nil
        local finalBoss=owner==self.raid and owner:holdsFinalBoss()
        local soft,hard=45,60
        if owner==self.storm then soft,hard=15,30 end
        if alternative and not finalBoss and(age>=hard or age>=soft and not fighting and not looting)then
            yielded=owner release(owner)owner=nil
        end
