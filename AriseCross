    end
    for _,name in ipairs({"storm","raid","worldBoss","pumpkins"})do
        if self[name]then table.insert(workers,self[name])end
    end
    for _,worker in ipairs(workers)do
        if worker.alive~=false then
            local ok,value=pcall(worker.wantsWork,worker)
            if not ok then
                worker:setEnabled(false)worker.status="Event stopped: "..tostring(value)
                warn("[senzy hub] "..worker.status)
