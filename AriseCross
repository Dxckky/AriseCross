    self.selectedIds,self.selectedCount={},0
    self.enemyId,self.monster=nil,nil
    if type(labels)=="string"then labels={labels}end
    if self.island and type(labels)=="table"then
        for _,label in ipairs(labels)do
            local monster=self.island.byLabel[label]
            if monster and not self.selectedIds[monster.id]then
                self.selectedIds[monster.id]=true self.selectedCount+=1
                self.monster=self.monster or monster self.enemyId=self.enemyId or monster.id
            end
        end
