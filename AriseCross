                if active and app.island and app.island.byLabel[name]then table.insert(labels,name)end
            end
            local same=#labels==app.selectedCount
            for _,label in ipairs(labels)do if not app.selectedIds[app.island.byLabel[label].id]then same=false break end end
            if same then return end
            app:selectMonster(labels)
            stopToggle()
        end,
    }, "SenzyAriseMonster")
    monsterDropdown:SetVisibility(true)
    local tpDelay=controls:Slider({Name="Delay After Kill (s)",Minimum=0,Maximum=10,Default=1,Precision=2,
