        section:Label({Text = "Collect pumpkins across islands. Empty selection = all islands."})
        local names, islands = {}, {}
        for _, island in ipairs(self.app.catalog.islands) do
            table.insert(names, island.name) islands[island.name] = island.key
        end
        local picker
        picker = section:Dropdown({Name = "Islands", Options = names, Multi = true, Search = true,
            Required = false, Callback = function()
                if not picker then return end
                self.selectedIslands = {}
                for label, on in pairs(picker:GetOptions()) do
                    if on and islands[label] then self.selectedIslands[islands[label]] = true end
                end
                self:release() self.target = nil self.nextScan = 0
            end}, "SenzyPumpkinIslands")
        local route
        route = section:Dropdown({Name = "Route", Options = ROUTES, Default = "Nearest", Required = true,
            Callback = function()
                if route then for name, on in pairs(route:GetOptions()) do
                    if on then self.route = name self.nextScan = 0 end
                end end
            end}, "SenzyPumpkinRoute")
        local enabled = section:Toggle({Name = "Auto Collect Pumpkins", Default = false, Callback = function(value)
            if not self.syncing then self:setEnabled(value) end
        end}, "SenzyPumpkins")
        section:Button({Name = "Rescan Pumpkins", Callback = function() self.nextScan = 0 end})
        local status = section:Label({Text = self.status})
        self.Controls = {Enabled = enabled, Islands = picker, Route = route}
        task.spawn(function()
            local last
            while self.alive and self.app.alive do
                local text = self.status .. " | Collected: " .. self.collected
                if self.enabled and self.app.eventOwner and self.app.eventOwner ~= self then
                    text = "Queued after " .. self.app.eventOwner.eventName .. " | Collected: " .. self.collected
                end
                if text ~= last then last = text pcall(status.UpdateName, status, text) end
                task.wait(0.5)
            end
        end)
    end

    function Pumpkins:Destroy()
        self.alive, self.enabled = false, false
        self:release()
        for _, connection in ipairs(self.connections) do connection:Disconnect() end
        table.clear(self.connections)
    end
    return Pumpkins
end)()

