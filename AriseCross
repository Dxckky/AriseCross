        if self.raid then self.raid:setEnabled(false)end
        if self.dungeon then
            self.dungeon:setJoin(false)self.dungeon:setFarm(false)
            if self.dungeon.onStopped then self.dungeon.onStopped()end
        end
    end
end
function Controller:spawnStep(character,root,humanoid,dt,now)
    local island=self.island
    if not island then self.status="Select an island"return false end
    local stats=self.adapter:getStats()
    if stats and stats:GetAttribute("Spawn")==island.key then self.spawnState=nil return false end
    local state=self.spawnState
    if not state or state.key~=island.key then
        state={key=island.key,attempts=0,nextTry=0}self.spawnState=state
    end
    if state.attempts>=3 then self.status="Spawn change not confirmed"return false end
    local extra=workspace:FindFirstChild("__Extra")
    local interactions=extra and extra:FindFirstChild("__Interactions")
    local spawns=interactions and interactions:FindFirstChild("Spawns")
    local entry=spawns and spawns:FindFirstChild(island.key)
    local prompt=entry and entry:FindFirstChild("SpawnPrompt",true)
    local position
    if prompt and prompt:IsA("ProximityPrompt")then
        local parent=prompt.Parent
        if parent:IsA("Attachment")then position=parent.WorldPosition
        elseif parent:IsA("BasePart")then position=parent.Position
        elseif parent:IsA("Model")then position=parent:GetPivot().Position end
    end
    local goal
    if position then
        local direction=Vector3.new(root.Position.X-position.X,0,root.Position.Z-position.Z)
        direction=direction.Magnitude>0.1 and direction.Unit or Vector3.new(0,0,1)
        local stand=position+direction*math.min(4,prompt.MaxActivationDistance*.5)
        local floor=self.adapter:groundAt(stand,4,128)
        goal=floor and Vector3.new(stand.X,floor.Y+self.adapter:standingHeight(character,root,humanoid),stand.Z)
    else goal=self.adapter:spawnPosition(island,character,root,humanoid)end
    if not goal then self.movement:stop()self.status="Waiting for island spawn"return true end
    self.status="Setting spawn: "..island.name
    local arrived,message=self.movement:step(character,root,humanoid,goal,position or goal,
        "TP",self.speed,"SetSpawn:"..island.key,dt,now)
    if message then
        if self.movement.corrections>=3 then self:stopAll(message)else self.status=message end
        return true
    end
    if not arrived or not position then return true end
    if not prompt.Enabled or(root.Position-position).Magnitude>prompt.MaxActivationDistance then return true end
    if now<state.nextTry then return true end
    if not self.autoSetSpawn or self.island~=island or not prompt.Parent then return true end
    state.attempts+=1 state.nextTry=now+3
    self.adapter.generalBridge:Fire({Event="ChangeSpawn",Spawn=island.key})
    return true
end

function Controller:setMode(mode)
    if mode ~= "TP" then return end
    if self.mode ~= mode then self:invalidate() self.mode=mode end
end

function Controller:stopAll(message)
    self.enabled, self.autoSetSpawn = false, false
    self:invalidate()
    self.status = message or "Stopped"
    if self.onStopped then self.onStopped() end
end

function Controller:clickStep(now)
    if self:isActive() or self.autoSetSpawn then
        self.clickStatus="Paused while Farm is active"
        return
    end
    local adapter=self.adapter
    local blocked=adapter:blocked(true)
    if blocked then self.clickStatus=blocked return end
    local _,root=adapter:character()
    if not root then self.clickStatus="Waiting for your character" return end
    adapter:refreshStats(now)
    if now<(adapter.nextAttack or 0)then return end
    local best,bestDistance=nil,math.min(adapter.range,25)
    for _,enemy in ipairs(adapter.enemies:GetChildren())do
        if enemy:IsA("BasePart")then
            local attrs=enemy:GetAttributes()
            if attrs.Dead~=true and attrs.Shield~=true
                and self.catalogModule.healthKey(attrs.HP)then
                local distance=(enemy.Position-root.Position).Magnitude
                if distance<=bestDistance then best,bestDistance=enemy,distance end
            end
        end
    end
    if not best then self.clickStatus="No living enemy in attack range" return end
    if adapter:attack(best,root,now)then
        self.clickCount+=1
        self.clickStatus="Clicking nearby enemy | Hits: "..self.clickCount
    else
        self.clickStatus="Waiting for game attack cooldown"
    end
end

function Controller:step(dt)
    if not self.alive then return end
    if self.shadowFollow then self.shadowFollow:tick(os.clock())end
    if self.castle and self.castle:step(dt)then return end
    if self.hunterTest and self.hunterTest:step(dt) then return end
    if self.mountHunt and self.mountHunt:step(dt) then return end
    if self.raid and self.raid:step(dt) then return end
    if self.dungeon and self.dungeon:step(dt) then return end
    if self.clickEnabled then self:clickStep(os.clock()) end
    if not self:isActive() and not self.autoSetSpawn then return end
    local adapter = self.adapter
    local blocked = adapter:blocked()
    if blocked then self:invalidate() self.status=blocked return end
    local character, root, humanoid = adapter:character()
    if not character then self:invalidate() self.status="Waiting for your character" return end
    if self.character ~= character then
        self:invalidate()
        self.character = character
    end
    local now = os.clock()
    if self.target and not adapter:enemyAlive(self.target)then
        if self.target.Parent==adapter.enemies then self.visited[self.target]=true end
        self:invalidate()self.movement:waitAfterEnemy(now)
    elseif self.target and not adapter:isTarget(self.target,self.island,self.selectedIds,self.catalogModule)then
        -- An alive target can become shielded or change eligibility after selection.
        self:invalidate()
    end
    if not self.target and self.movement:waitingForEnemy(now)then
        self.movement:stop()self.status="Waiting after target death"return
    end
    if self.autoSetSpawn and not(self.target and adapter:enemyAlive(self.target))
        and self:spawnStep(character,root,humanoid,dt,now)then return end
    if not self:isActive()then return end
    local island, enemyId = self.island, self.selectedIds
    if not self:selectionReady() then self:stopAll("Select an island and monster") return end
    if not self.target and now>=self.nextSearch then
        self.nextSearch=now+0.1
        for enemy in pairs(self.visited)do if not enemy.Parent then self.visited[enemy]=nil end end
        local best=adapter:randomTarget(island,enemyId,self.catalogModule,self.visited)
        if not best and next(self.visited)then
            self.visited={}
            best=adapter:randomTarget(island,enemyId,self.catalogModule)
        end
        if best~=self.target then
            self.target=best self.generation+=1
            self.movement:stop()
        end
    end
    local target, goal, lookAt, key = self.target
    local info=target and adapter.enemyInfo[target:GetAttribute("Id")]
    local targetName=info and info.Name or "selected monsters"
    if target then
        if not adapter:isTarget(target,island,enemyId,self.catalogModule)then
            self.movement:stop()self.status="Waiting for the current target"return
        end
        goal = adapter:targetPosition(target,character,root,humanoid,now)
        if not goal then
            self.movement:stop()
            self.status = "Waiting for ground under the selected monster"
            return
        end
        lookAt, key = target.Position, target
    else
        local present = false
        for _, enemy in ipairs(adapter.enemies:GetChildren()) do
            if tostring(enemy:GetAttribute("MapId")) == island.mapId then present=true break end
        end
        local spawn = adapter:spawnPosition(island,character,root,humanoid)
        local nearIsland = spawn and (root.Position-spawn).Magnitude < 1800
        if present and nearIsland then
            self.movement:stop()
            self.status = "Waiting for " .. targetName
            return
        end
        goal = spawn
        if not goal then self.movement:stop() self.status="Island spawn is unavailable" return end
        if (root.Position-goal).Magnitude < 15 then
            self.movement:stop()
            self.status="Waiting for island monsters to load"
            return
        end
        lookAt, key = goal+Vector3.new(0,0,-1), island.key
    end
    if target and self.shadowFollow then
        local ready,reason=self.shadowFollow:beforeMove(target,character,root,goal,now)
        if not ready then self.movement:stop()self.status=reason return end
    end
    local arrived, message = self.movement:step(character,root,humanoid,goal,lookAt,
        self.mode,self.speed,key,dt,now)
    if message then
        if self.movement.corrections >= 3 then self:stopAll(message) else self.status=message end
        return
    end
    if not arrived then
        self.status = "Moving to "
            .. (target and targetName or island.name)
        return
    end
    if target and self.shadowFollow and not self.shadowFollow:afterMove(true,now)then
        self.status="Summoning shadows at target"return
    end
    if not target then self.status="Waiting for island monsters to load" return end
    self.status = "Farming " .. targetName .. " | HP " .. tostring(target:GetAttribute("HP"))
    -- All operations below are non-yielding; never use a delayed task with an old target.
    if not self:isActive() or self.target ~= target
        or not adapter:isTarget(target,island,enemyId,self.catalogModule) then return end
    if self.enabled and adapter:isTarget(target,island,enemyId,self.catalogModule) then
        if adapter:attack(target,root,now) then self.requests += 1 end
    end
end

function Controller:start()
    local runService = game:GetService("RunService")
    local busy = false
    table.insert(self.connections,runService.Heartbeat:Connect(function(dt)
        if busy or not self.alive then return end
        busy = true
        local ok,err = pcall(self.step,self,dt)
        busy = false
        if not ok then
            self.clickEnabled=false
            if self.onClickStopped then self.onClickStopped() end
            self:stopAll("Farm stopped: " .. tostring(err))
            warn("[senzy hub] " .. tostring(err))
        end
    end))
    table.insert(self.connections,self.adapter.player.CharacterAdded:Connect(function()
        self:invalidate()
        self.movement.corrections = 0
        self.character = nil
    end))
    task.spawn(function()
        while self.alive do
            if self:isActive() or self.clickEnabled or (self.dungeon and self.dungeon:isFarming()) or (self.raid and self.raid.enabled) or (self.hunterTest and self.hunterTest.enabled) then
                local ok,err = pcall(self.adapter.refreshStats,self.adapter,os.clock())
                if not ok then warn("[senzy hub] Combat stats: " .. tostring(err)) end
            end
            task.wait(1)
        end
    end)
end

function Controller:Destroy()
    if not self.alive then return end
    if self.config then self.config:Destroy()end
    self.alive,self.enabled,self.clickEnabled = false,false,false
    if self.shadowFollow then self.shadowFollow:Destroy()end
    if self.sell then self.sell:Destroy()end
    if self.castle then self.castle:Destroy()end
    if self.defeat then self.defeat:Destroy()end
    if self.server then self.server:Destroy()end
    if self.companions then self.companions:Destroy() end
    if self.hunterTest then self.hunterTest:Destroy() end
    if self.mountHunt then self.mountHunt:Destroy() end
    if self.raid then self.raid:Destroy() end
    if self.dungeon then self.dungeon:Destroy() end
    self:invalidate()
    for _,connection in ipairs(self.connections) do connection:Disconnect() end
    table.clear(self.connections)
    if self.window then self.window:Unload() end
    if getgenv().SenzyAriseFarm == self then getgenv().SenzyAriseFarm=nil end
end

return Controller
end)()

