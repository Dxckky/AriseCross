    if not self.app.dungeon:save()then return false,"Cannot save teleport loader"end
    local queue=type(queue_on_teleport)=="function"and queue_on_teleport
        or type(queueonteleport)=="function"and queueonteleport
    if not queue then return false,"Executor has no teleport resume support"end
    if getgenv().__SenzyHunterQueued then return true end
    local code=[[
 task.spawn(function()
    if not game:IsLoaded()then game.Loaded:Wait()end
    local allowed={[128336380114944]=true,[73588121595735]=true,[87039211657390]=true,
        [75812907038499]=true,[131604490933694]=true,[80896993021375]=true,
        [88685840848627]=true,[112387026435138]=true}
    if not allowed[game.PlaceId]then return end
    local ok,saved=pcall(function()return game:GetService("HttpService"):JSONDecode(readfile("SenzyAriseFarm/hunter.json"))end)
    if not ok or type(saved)~="table"or not saved.enabled
        or os.time()-(tonumber(saved.started)or 0)>1200 then return end
    local rs=game:GetService("ReplicatedStorage")
    local deadline=os.clock()+30
    while (game.PlaceId==128336380114944 or game.PlaceId==73588121595735)
        and rs:GetAttribute("IsTest")==nil and os.clock()<deadline do task.wait(.1)end
    if not saved.confirmed and rs:GetAttribute("IsTest")~=true then return end
    getgenv().__SenzyHunterResume=true
    local source=readfile("SenzyAriseFarm/loader.luau")
    getgenv().__SenzyAriseFarmSource=source
    local run,err=loadstring(source)
    if not run then warn("[senzy hub] Hunter resume failed",err)return end
    run()
 end)
]]
    local ok,err=pcall(queue,code)
    if not ok then return false,tostring(err)end
    getgenv().__SenzyHunterQueued=true
    return true
end
function HunterTest:requirements()
    local stats=self.adapter:getStats()
    local rank=stats and tonumber(stats:GetAttribute("Rank"))
    local info=rank and self.info[rank+1]
    local normal=stats and stats:FindFirstChild("Quests")and stats.Quests:FindFirstChild("Normal")
    local quest=not(info and info.NeedQuest)or normal and normal:FindFirstChild(info.NeedQuest)~=nil
    local ok,reason=HunterTest.canStart(rank,tonumber(self.adapter.balanceInfo.MaxPlayerRank)or 42,
        info,stats and stats:GetAttribute("Awaken")==true,quest)
    return ok,reason,rank,info
end
function HunterTest:nativeTest()
    local rs=self.adapter.rs
    if rs:GetAttribute("IsTest")~=true then return false end
    for _,flag in ipairs({"HLRaid","IsCastle","IsHeavenCastle","InInfinite","InInfiniteC","InInfiniteL","InRush","InTimeTrial"})do
        if rs:GetAttribute(flag)==true then return false end
    end
    return rs:GetAttribute("Dungeon")~=false
end
function HunterTest:inTest()
    if not self.enabled then return false end
    if self:nativeTest()then return true end
    local rs=self.adapter.rs
    -- Compatibility only when the native discriminator has not been supplied.
    if rs:GetAttribute("IsTest")~=nil then return false end
    for _,flag in ipairs({"HLRaid","IsCastle","IsHeavenCastle","InInfinite","InInfiniteC","InInfiniteL","InRush","InTimeTrial"})do
        if rs:GetAttribute(flag)==true then return false end
    end
    return self.confirmed and INSTANCES[game.PlaceId]==true and rs:GetAttribute("Dungeon")==true
end
function HunterTest:syncToggle()
    local toggle=self.Controls and self.Controls.Enabled
    self.syncing=true
    if toggle and toggle:GetState()~=self.enabled then toggle:UpdateState(self.enabled)end
    self.syncing=false
end
function HunterTest:stop(message)
    if not self.enabled and self.stage=="idle"then self:syncToggle()return end
    self.enabled=false self.confirmed=false self.stage="idle"
    self.combat.target=nil self.combat.farmEnabled=false
    self.combat:release()
    if self.owns then self.app:invalidate()self.owns=false end
    self.status=message or "Stopped"
    self:save()self:syncToggle()
end
function HunterTest:start()
    if not self.alive or self.enabled then return end
    if self:nativeTest()then
        local stats=self.adapter:getStats()
        self.startRank=tonumber(stats and stats:GetAttribute("Rank"))or 0
        self.started=os.time()self.waitStarted=os.clock()self.enabled=true self.confirmed=true
        self.stage="loading"self.teleporting=false self.owns=false self.room=nil
        self.returnAt=nil self.returnAttempts=0 self.finalEnemySeen=false self.finalEmptySince=nil
        self.timerStarted=false self.timerExpiredAt=nil
        self.combat:release()self.combat.target=nil self.combat.nextEnemy=0 self.combat.lastRoom=nil
        self.combat.farmEnabled=true self.combat.timeLeft=nil self.app.movement.corrections=0
        self.status="Loading current Hunter Test"self:save()self:syncToggle()
        return
    end
    if self.app.desert then self.app.desert:stop("Hunter Test selected")end
    if not WORLDS[game.PlaceId]or self.adapter.rs:GetAttribute("Dungeon")==true then self.status="Return to the main world"return end
    if self.adapter.player:GetAttribute("InDungeon")==true then self.status="Leave the existing dungeon party first"return end
    local ok,reason,rank=self:requirements()
    if not ok then self.status=reason return end
    if self.app.castle then self.app.castle:stop("Hunter Test selected")end
    self.app:stopAll("Hunter Test active",true)
    if self.app.mountHunt then self.app.mountHunt:setEnabled(false)end
    local d=self.app.dungeon
    d:setJoin(false)d:setFarm(false)if d.setReplay then d:setReplay(false)end
    if d.onStopped then d.onStopped()end
    self.startRank=rank self.started=os.time()self.waitStarted=os.clock()self.confirmed=false
    self.enabled=true self.stage="queued"self.teleporting=false
    self.returnAt=nil self.returnAttempts=0 self.finalEnemySeen=false self.finalEmptySince=nil
    self.room=nil self.roomChangedAt=nil self.timerStarted=false self.timerExpiredAt=nil
    self.combat.farmEnabled=true self.combat.timeLeft=nil self.combat.target=nil
    self.app.movement.corrections=0
    local ready,err=self:prepareResume()
    if not ready then self:stop(err)return end
    if self.adapter.player:GetAttribute("Mounted")==true then
        self.adapter.generalBridge:Fire({Event="MountAction",Action="Dismount"})
    end
    self.status="Hunter Test queued"
end
function HunterTest:finalBossCleared(now)
    local room=tonumber(self.adapter.rs:GetAttribute("CurrentRoom"))
    local maximum=tonumber(self.adapter.rs:GetAttribute("MaxDGRoom"))
    if not room or not maximum or maximum<1 or room<maximum then self.finalEmptySince=nil return false end
    local message=self.adapter.rs:GetAttribute("DungeonMessage")
    local left,total
    if type(message)=="string"then
        left,total=message:gsub("<[^>]*>",""):lower():match("enemies%s+left%s*:%s*(%d+)%s*/%s*(%d+)")
        left,total=tonumber(left),tonumber(total)
    end
    if left and left>0 then self.finalEmptySince=nil return false end
    for _,enemy in ipairs(self.adapter:enemyList())do
        if self.adapter:enemyAlive(enemy)then
            local enemyRoom=enemy:GetAttribute("Room")or enemy:GetAttribute("RoomId")
            if enemyRoom==nil or tostring(enemyRoom)==tostring(room)then
                self.finalEnemySeen=true self.finalEmptySince=nil return false
            end
        end
    end
    if not self.finalEnemySeen then
        if left~=0 or not total or total<1 or now-(self.roomChangedAt or now)<2 then return false end
    end
    self.finalEmptySince=self.finalEmptySince or now
    return now-self.finalEmptySince>=4
end
function HunterTest:returnToMain(now)
    self.stage="returning"self.combat.farmEnabled=false self.combat.target=nil
    self.combat:release()self.app.movement:stop()
    self.status="Test cleared - returning to main world"
    if self.returnAt and now-self.returnAt<8 then return true end
    if(self.returnAttempts or 0)>=3 then self:stop("Return to main world not confirmed")return true end
    local ready,reason=self:prepareResume()
    if not ready then self:stop(reason)return true end
    self.returnAttempts=(self.returnAttempts or 0)+1 self.returnAt=now self:save()
    self.adapter.generalBridge:Fire({Event="LeaveDungeon"})
    return true
end
function HunterTest:_step(dt)
    if not self.enabled then return false end
    local now=os.clock()
    if self:nativeTest()and not self.confirmed then self.confirmed=true self:save()end
    if self.stage=="queued"and not self:inTest()then
        if self.adapter.rs:GetAttribute("Dungeon")==true then return false end
        self.stage="entering"self.waitStarted=os.clock()
        self.adapter.generalBridge:Fire({Event="DungeonAction",Action="TestEnter"})
        return true
    end
    if not self.owns then self.app:invalidate()self.owns=true end
    local stats=self.adapter:getStats()
    local rank=tonumber(stats and stats:GetAttribute("Rank"))
    local inside=self:inTest()
    local passed=rank and rank>self.startRank
    if inside and(passed or self.stage=="returning")then return self:returnToMain(os.clock())end
    if not inside then
        self.app.movement:stop()
        self.status="Waiting for Hunter Test instance"
        if WORLDS[game.PlaceId]and(passed or self.stage=="returning"or self.stage=="running"or self.stage=="loading")then
            self:stop((passed and "Passed | Rank: "or "Test ended | Rank: ")..tostring(self.adapter.basicInfo.Ranks[rank]or "No Rank"))
        elseif os.clock()-(self.waitStarted or os.clock())>60 then self:stop("Entry not confirmed - start again when ready")end
        return true
    end
    if self.stage~="running"then
        self.stage="running"self.combat.target=nil self.combat.nextEnemy=0 self.combat.lastRoom=nil
        self.combat.timeLeft=self.timerStarted and self.combat.timeLeft or nil
        self:save()
    end
    local room=self.adapter.rs:GetAttribute("CurrentRoom")
    if room~=self.room then
        self.room=room self.roomChangedAt=now self.finalEnemySeen=false self.finalEmptySince=nil
        self.combat:release()self.combat.target=nil self.combat.nextEnemy=0 self.combat.lastRoom=nil
        self.app.movement:stop()
    end
    if self:finalBossCleared(os.clock())then return self:returnToMain(os.clock())end
    if self.timerStarted and self.combat.timeLeft and self.combat.timeLeft<=0
        and self.timerExpiredAt and now-self.timerExpiredAt>=2 then self:stop("Hunter Test time ended")return true end
    if os.time()-self.started>1100 then self:stop("Hunter Test timed out")return true end
    local character,root,humanoid=self.adapter:character()
    if not character then self.app.movement:stop()self.status="Waiting for character"return true end
    local blocked=self.adapter:blocked(true)
    if blocked then self.app.movement:stop()self.status=blocked return true end
    if self.combat.target and not self.combat:aliveEnemy(self.combat.target)then
        self.combat:release()self.combat.target=nil self.combat.nextEnemy=0
        self.app.movement:stop()
    end
    if self.adapter.requestArea then
        local target=self.combat.target
        self.adapter:requestArea(target and target.Position or root.Position,
            "HunterRoom:"..tostring(room),now)
    end
    self.combat.farmEnabled=true
    local expired=self.combat.timeLeft and self.combat.timeLeft<=0
    if not expired then self.combat:farmStep(character,root,humanoid,dt,now)
    else self.app.movement:stop()end
    self.status="Room "..tostring(self.adapter.rs:GetAttribute("CurrentRoom")or "?")
        .." / "..tostring(self.adapter.rs:GetAttribute("MaxDGRoom")or "?")
    if self.app.movement.corrections>=3 then self:stop("Movement was reset repeatedly")end
    return true
end
function HunterTest:step(dt)
    if not self.alive then return false end
    local ok,result=pcall(self._step,self,dt)
    if not ok then self:stop("Hunter Test stopped: "..tostring(result))warn("[senzy hub] "..self.status)return false end
    return result
end
function HunterTest:Destroy()
    if not self.alive then return end
    if not self.teleporting then self:stop("Stopped")end
    self.alive=false self.combat:release()
    for _,c in ipairs(self.connections)do pcall(function()c:Disconnect()end)end
    table.clear(self.connections)
end
function HunterTest:mount(group)
    local tab=group:Tab({Name="Main"})
    self.tab=tab
    local section=tab:Section({Name="Hunter Rank Test",Side="Left"})
    local rankLabel=section:Label({Text="Rank: ..."})
    local toggle
    toggle=section:Toggle({Name="Auto Hunter Test",Default=self.enabled,Callback=function(value)
        if not self.alive or self.syncing or(toggle and toggle:GetState()~=(value==true))then return end
        if value==true then self:start()self:syncToggle()
        elseif self.enabled then self:stop("Stopped")end
    end},"SenzyAutoHunterTest")
    local status=section:Label({Text=self.status})
    self.Controls={Enabled=toggle,Rank=rankLabel}
    self:syncToggle()
    task.spawn(function()
        local lastRank,lastStatus
        while self.alive and self.app.alive do
            local _,reason,rank=self:requirements()
            local ranks=self.adapter.basicInfo.Ranks
            local text="Rank: "..tostring(ranks[rank]or "No Rank").." | Next: "..tostring(rank and ranks[rank+1]or "Max")
            if lastRank~=text then lastRank=text pcall(rankLabel.UpdateName,rankLabel,text)end
            local current=self.status=="Idle"and reason or self.status
            if current~=lastStatus then lastStatus=current pcall(status.UpdateName,status,current)end
            task.wait(0.3)
        end
    end)
end
return HunterTest
end)()

local Companions=(function()
local Companions={}
Companions.__index=Companions
local SETTINGS="SenzyAriseFarm/companions.json"
function Companions.damageKey(value)
    if type(value)=="table"then
        local key=Catalog.healthKey(value.first)
        local exponent=tonumber(value.second)
        if key and exponent and exponent==exponent then return {key[1]+exponent,key[2]}end
        return
    end
    return Catalog.healthKey(value)
end
function Companions.sameSet(list,current)
    local wanted={}local count=0
    for _,id in ipairs(list)do wanted[id]=true end
    for _,id in pairs(current)do
        if type(id)=="string"then
            if not wanted[id]then return false end
            wanted[id]=nil count+=1
        end
    end
    return count==#list and next(wanted)==nil
end
function Companions.new(app,resume)
    local saved={}
    if type(readfile)=="function"then
        local ok,data=pcall(function()return game:GetService("HttpService"):JSONDecode(readfile(SETTINGS))end)
        if ok and type(data)=="table"and (data.version==1 or data.version==2) then saved=data end
    end
    local self=setmetatable({app=app,adapter=app.adapter,alive=true,
        autoEquip=resume and saved.autoEquip==true or false,autoSummon=resume and saved.autoSummon==true or false,
        connections={},nextEquipRequest=0,nextShow=0},Companions)
    self:save()
    task.spawn(function()
        local nextEquip=0
        while self.alive and self.app.alive do
            local now=os.clock()
            if self.autoSummon then
                local ok,err=pcall(self.summon,self,now)
                if not ok then self:setAutoSummon(false)warn("[senzy hub] Auto Summon Shadows stopped: "..tostring(err))end
            end
            if self.autoEquip and now>=nextEquip then
                nextEquip=now+1
                local ok,err=pcall(self.equipBest,self,now)
                if not ok then self:setAutoEquip(false)warn("[senzy hub] Auto Equip Best stopped: "..tostring(err))end
            end
            task.wait(0.25)
        end
    end)
    return self
end
function Companions:save()
    pcall(function()
        if type(writefile)~="function"or type(makefolder)~="function"or type(isfolder)~="function"then return end
        if not isfolder("SenzyAriseFarm")then makefolder("SenzyAriseFarm")end
        writefile(SETTINGS,game:GetService("HttpService"):JSONEncode({version=2,autoEquip=self.autoEquip,autoSummon=self.autoSummon}))
    end)
end
function Companions:setAutoEquip(value)
    self.autoEquip=value==true self.nextEquipRequest=0 self:save()
    if not self.autoEquip and self.Controls and self.Controls.Equip:GetState()then self.Controls.Equip:UpdateState(false)end
end
function Companions:setAutoSummon(value)
    self.autoSummon=value==true self.nextShow=0 self:save()
    if not self.autoSummon and self.Controls and self.Controls.Summon:GetState()then self.Controls.Summon:UpdateState(false)end
end
function Companions:equipBest(now)
    if not self.autoEquip or not self.alive or not self.app.alive then return end
    local stats=self.adapter:getStats()
    local inventory=stats and stats:FindFirstChild("Inventory")
    local pets=inventory and inventory:FindFirstChild("Pets")
    local equips=stats and stats:FindFirstChild("Equips")
    local equipped=equips and equips:FindFirstChild("Pets")
    if not pets or not equipped then return end
    local current=equipped:GetAttributes()
    local selected={}for _,id in pairs(current)do if type(id)=="string"then selected[id]=true end end
    local ranked,maximum=self.adapter:bestPetCandidates(pets,selected,Companions.damageKey)
    if not ranked or maximum<1 then return end
    table.sort(ranked,function(a,b)
        local compare=Catalog.compareHealthKeys(a.damage,b.damage)
        if compare~=0 then return compare>0 end
        if a.equipped~=b.equipped then return a.equipped end
        return a.id<b.id
    end)
    local best={}
    for i=1,math.min(maximum,#ranked)do table.insert(best,ranked[i].id)end
    if #best==0 or Companions.sameSet(best,current)then return end
    if now<self.nextEquipRequest then return end
    if not self.autoEquip or not self.alive or not self.app.alive then return end
    for _,id in ipairs(best)do
        local pet=pets:FindFirstChild(id)
        if not pet or pet:GetAttribute("InExp")==true then return end
    end
    self.nextEquipRequest=now+3
    self.adapter.shadowBridge:Fire({Event="EquipBest",Pets=best})
end
function Companions:summon(now)
    if not self.alive or not self.app.alive or not self.autoSummon or now<self.nextShow then return end
    if self.app.shadowFollow and self.app.shadowFollow:busy()then return end
    local player=self.adapter.player
    -- ShowPets is a toggle: only send when the server explicitly says the army is hidden.
    if player:GetAttribute("PetsArise")~=false then return end
    local character=self.adapter:character()
    if not character or player:GetAttribute("Mounted")==true or player:GetAttribute("Teleporting")==true
        or character:GetAttribute("Swimming")==true or character:GetAttribute("InTp")==true
        or character:GetAttribute("InGuild")==true then return end
    local stats=self.adapter:getStats()
    local equips=stats and stats:FindFirstChild("Equips")
    local pets=equips and equips:FindFirstChild("Pets")
    if not pets then return end
    local hasEquipped=false
    for _,id in pairs(pets:GetAttributes())do
        if type(id)=="string"and id~=""then hasEquipped=true break end
    end
    if not hasEquipped then return end
    if not self.autoSummon or player:GetAttribute("PetsArise")~=false then return end
    self.nextShow=now+3
    self.adapter.shadowBridge:Fire({Event="ShowPets"})
end
function Companions:Destroy()
    if not self.alive then return end
    self.alive=false self.autoEquip=false self.autoSummon=false
    for _,c in ipairs(self.connections)do pcall(function()c:Disconnect()end)end
    table.clear(self.connections)
end
function Companions:mount(tab)
    local section=tab:Section({Name="Shadows",Side="Right"})
    local equip,summon
    equip=section:Toggle({Name="Auto Equip Best",Default=self.autoEquip,Callback=function(value)
        if self.alive and(not equip or equip:GetState()==(value==true))then self:setAutoEquip(value)end
    end},"SenzyAutoEquipBest")
    summon=section:Toggle({Name="Auto Summon Shadows",Default=self.autoSummon,Callback=function(value)
        if self.alive and(not summon or summon:GetState()==(value==true))then self:setAutoSummon(value)end
    end},"SenzyAutoSummonShadows")
    self.Controls={Equip=equip,Summon=summon}
end
return Companions
end)()

local Server=(function()
-- Private-server invitation links are opened through Roblox's URL flow.
-- A URL link code is not treated as a reserved-server access code.
local Server={}
Server.__index=Server
local SETTINGS="SenzyAriseFarm/server-link.json"
function Server.normalize(value)
    if type(value)~="string"then return nil,"Paste a Roblox private server link"end
    local url=value:match("^%s*(.-)%s*$")
    if #url==0 or #url>2048 or url:find("[%c%s]")then return nil,"Invalid server link"end
    url=url:gsub("^http://","https://")
    local host,path=url:match("^https://([^/]+)(/.*)$")
    if not host or(host:lower()~="roblox.com"and host:lower()~="www.roblox.com")then
        return nil,"Use a roblox.com private server link"
    end
    local route,query=path:match("^([^?]+)%?(.*)$")
    if not route then return nil,"Private server code missing"end
    local params={}
    for key,val in query:gmatch("([^&=?]+)=([^&#]*)")do params[key:lower()]=val end
    if route:match("^/games/%d+/?[^?]*$")then
        if not params.privateserverlinkcode or not params.privateserverlinkcode:match("^[%w_%-]+$")then
            return nil,"Private server link code missing"
        end
    elseif route=="/share"or route=="/share/"or route=="/share-links"or route=="/share-links/"then
        if not params.code or not params.code:match("^[%w_%-]+$")or not params.type or params.type:lower()~="server"then
            return nil,"Use a server invitation share link"
        end
    else return nil,"Unsupported Roblox server link"end
    return "https://www.roblox.com"..path
end
function Server.launchUrl(value)
    local url,reason=Server.normalize(value)
    if not url then return nil,reason end
    local path=url:match("^https://www%.roblox%.com(.*)$")
    local route,query=path:match("^([^?]+)%?(.*)$")
    local params={}for key,val in query:gmatch("([^&=?]+)=([^&#]*)")do params[key:lower()]=val end
    local place=route:match("^/games/(%d+)")
    if place then return "roblox://placeId="..place.."&linkCode="..params.privateserverlinkcode,url end
    return "roblox://navigation/share_links?code="..params.code.."&type=Server",url
end
function Server.new(app)
    local self=setmetatable({app=app,alive=true,link="",status="",nextOpen=0},Server)
    if type(readfile)=="function"then
        local ok,data=pcall(function()return game:GetService("HttpService"):JSONDecode(readfile(SETTINGS))end)
        if ok and type(data)=="table"and data.version==1 then self.link=Server.normalize(data.link)or ""end
    end
    return self
end
function Server:setStatus(text)
    self.status=text
    if self.statusLabel then pcall(self.statusLabel.UpdateName,self.statusLabel,text)end
end
function Server:save()
    pcall(function()
        if type(writefile)~="function"or type(makefolder)~="function"or type(isfolder)~="function"then return end
        if not isfolder("SenzyAriseFarm")then makefolder("SenzyAriseFarm")end
        writefile(SETTINGS,game:GetService("HttpService"):JSONEncode({version=1,link=self.link}))
    end)
end
function Server:currentLink()
    if self.Controls and self.Controls.Link then
        local ok,value=pcall(self.Controls.Link.GetInput,self.Controls.Link)
        if ok and type(value)=="string"then return value end
    end
    return self.link
end
function Server:openForReturn()
    local launch,url=Server.launchUrl(self:currentLink())
    if not launch then self:setStatus(url)return false end
    self.link=url self:save()
    -- Opening a URL is a launch request, not proof that Roblox joined the destination.
    local opener=self.directOpener or openurl
    if type(opener)=="function"then
        local ok,result=pcall(opener,launch)
        if ok and result~=false then self:setStatus("Private server launch requested")return true,"direct"end
    end
    local opened=(self.opener or Server.openLink)(url)
    if opened then self:setStatus("Server link opened - Roblox may require Join / Play")return true,"browser"end
    self:setStatus("Unable to open server link - returning to main world")return false
end
function Server.openLink(url)
    if type(openurl)=="function"then
        local ok,result=pcall(openurl,url)
        if ok and result~=false then return true end
    end
    for _,service in ipairs({"GuiService","BrowserService"})do
        local ok,result=pcall(function()return game:GetService(service):OpenBrowserWindow(url)end)
        if ok and result~=false then return true end
    end
    return false
