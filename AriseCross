        attempt.nextTry = now + math.max(2, hold + .5) self.nextCollect = now + .5
        self.status = sent and "Collecting pumpkin | Awaiting server confirmation" or "Pumpkin prompt input unavailable"
        return true
    end

    function Pumpkins:step(dt)
        local ok, result = pcall(self._step, self, dt)
        if not ok then
            self:setEnabled(false) self.status = "Pumpkin collection stopped: " .. tostring(result)
            warn("[senzy hub] " .. self.status)
            return false
        end
        return result
    end

    function Pumpkins:settings()
        return {enabled = self.enabled, route = self.route, islands = table.clone(self.selectedIslands)}
    end

    function Pumpkins:restore(saved)
        saved = type(saved) == "table" and saved or {}
        self.route = saved.route == "Storm First" and "Storm First" or "Nearest"
        self.selectedIslands = {}
        local labels = {}
        for key, on in pairs(type(saved.islands) == "table" and saved.islands or {}) do
            local island = self.app.catalog.byKey[key]
            if on == true and island then self.selectedIslands[key] = true table.insert(labels, island.name) end
        end
        self.Controls.Route:UpdateSelection({self.route})
        self.Controls.Islands:UpdateSelection(labels)
        self:setEnabled(saved.enabled)
    end

    function Pumpkins:mount(tab)
