    local path=table.clone(self._path)table.insert(path,tostring(key))return self._owner:node(path)
end
function Node:GetChildren()
    local result={}
    local value=self:Raw()
    if type(value)=="table"then for key in pairs(value)do table.insert(result,self:FindFirstChild(key))end end
    return result
end
function Node:IsA(class)return class=="Folder"or class=="Instance"end
Node.__index=function(self,key)
    if Node[key]then return Node[key]end
    if key=="Name"then return tostring(self._path[#self._path]or "leaderstats")end
    if key=="Parent"then return self:Raw()~=nil and self._owner.player or nil end
