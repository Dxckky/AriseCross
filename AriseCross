function Dungeon:requestReturn(now,reason)
    self:claim("return")self.app.movement:stop()
    if self.returnAt and now-self.returnAt<8 then self.status=reason return true end
    if self.returnAttempts>=3 then self:stop("Return to main world was not confirmed")return true end
    self:prepareResume()self:save()
    self.returnAttempts+=1 self.returnAt=now self.status=reason
    self.general:Fire({Event="LeaveDungeon"})
    return true
end
function Dungeon:lifecycleStep(now)
    local session=self.session
    local expired=session and session.expiresAt and self:serverNow()>=session.expiresAt
    if expired or self.timeLeft and self.timeLeft<=0 then
        if session then session.expired=true end
        return self:requestReturn(now,"Dungeon closed - returning to main world")
    end
    if self.returnAt then return self:requestReturn(now,"Returning to main world")end
    local room=tonumber(self.adapter.rs:GetAttribute("CurrentRoom"))
    local maximum=tonumber(self.adapter.rs:GetAttribute("MaxDGRoom"))
    local final=room and maximum and maximum>0 and room>=maximum
    local alive=0
    if final then
        for _,enemy in ipairs(self.adapter.enemies:GetChildren())do
            if self.adapter:enemyAlive(enemy)then
                local enemyRoom=enemy:GetAttribute("Room")or enemy:GetAttribute("RoomId")
                if not enemyRoom or sameId(enemyRoom,room)then alive+=1 end
            end
        end
        if alive>0 then self.lastRoomHadEnemies=true self.emptyFinalSince=nil end
    end
    if final and alive==0 and(self.lastRoomHadEnemies or self.winSignal or session and self:alreadyCleared(session))then
        self.emptyFinalSince=self.emptyFinalSince or now
        if now-self.emptyFinalSince>=4 then
            if session then session.finished=true end
            return self:requestReturn(now,"Dungeon cleared - returning to main world")
        end
    else self.emptyFinalSince=nil end
    return false
end

function Dungeon:claim(kind)
    if self.owner~=kind then self.app:invalidate()self.owner=kind end
end
function Dungeon:release()
    if self.owner then self.app:invalidate()self.owner=nil end
end
function Dungeon:setRanks(labels)
    local chosen={}
    if type(labels)=="table"then
        for _,label in ipairs(labels)do
            local id=self.rankIds[label]
            if id then chosen[id]=true end
        end
    end
    local previous=self.filters.ranks or {}
    local changed=false
    for id in pairs(previous)do if not chosen[id]then changed=true break end end
    if not changed then for id in pairs(chosen)do if not previous[id]then changed=true break end end end
    if not changed then return end
    self.filters.ranks=chosen
    self.generation+=1
    self:cancelPending()
    self:release()
    self.nextScan=0
    self.status=next(chosen)and "Rank filters updated"or "All ranks selected"
    self:save()
end
function Dungeon:setFilter(key,value)
    local resolved
    if key=="rank"then return self:setRanks(value=="Any"and {}or {value})end
    if key=="island" then
        resolved=value~="Any" and self.islandKeys[value] or nil
        if value~="Any" and not resolved then return end
    elseif key=="difficulty" then
        if value~="Any" and value~="Normal" and value~="Red" then return end
        resolved=value~="Any" and value or nil
    else return end
    if self.filters[key]==resolved then return end
    self.filters[key]=resolved
    self.generation+=1
    self:cancelPending()
    self:release()
    self.nextScan=0
    self.status="Filters updated; waiting for an exact match"
    self:save()
end
