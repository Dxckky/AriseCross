        if dead~=nil then attrs.Dead=dead end
        if self.enemyLocal.Arised then attrs.Arised=self.enemyLocal.Arised(enemy)end
    end
    if self.deadEnemies and self.deadEnemies[enemy]then attrs.Dead=true attrs.HP=0 end
