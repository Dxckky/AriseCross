local Catalog=(function()
-- Pure catalog helpers. Island membership comes from its quest chain, not World alone.
local Catalog = {}

local function sameWorld(value, expected)
    local number = tonumber(value)
    return number ~= nil and number == tonumber(expected)
end

local function modelFor(info, enemyInfo, seen)
    if type(info) ~= "table" then return nil end
    if info.Model ~= nil then return info.Model end
    local base = info.BaseInfo
    if type(base) ~= "string" or seen[base] then return nil end
    seen[base] = true
    return modelFor(enemyInfo[base], enemyInfo, seen)
end

local function addQuestEnemies(island, map, enemyInfo, quests)
    local key, seen = map.WorldQuest, {}
    while type(key) == "string" and not seen[key] do
        seen[key] = true
        local quest = quests[key]
        if type(quest) ~= "table" then break end
        local goals = type(quest.Goals) == "table" and quest.Goals or {}
        -- Any spawn boundary ends this island's chain, including another island's.
        local boundary = false
        for goal in pairs(goals) do
            if type(goal) == "string" and goal:match("^Spawn") then
                boundary = true
                break
            end
        end
        if boundary then break end
        for goal in pairs(goals) do
            local id = type(goal) == "string" and goal:match("^(.+)Defeated$")
            local info = id and enemyInfo[id]
            if type(info) == "table" and sameWorld(info.World, island.order)
                and info.TypeC == "Normal" and info.TypeG == nil then
                island.ids[id] = true
            end
        end
        key = quest.NeedQuest
    end
end

local function matchesModel(info, models, enemyInfo, seen)
    if type(info) ~= "table" then return false end
    if info.Model ~= nil and models[info.Model] then return true end
    local base = info.BaseInfo
    if type(base) ~= "string" or seen[base] then return false end
    seen[base] = true
    return matchesModel(enemyInfo[base], models, enemyInfo, seen)
end

local function addBrutes(island, enemyInfo)
    local models = {}
    for id in pairs(island.ids) do
        local model = modelFor(enemyInfo[id], enemyInfo, {})
        if model ~= nil then models[model] = true end
    end
    for id, info in pairs(enemyInfo) do
        if type(id) == "string" and type(info) == "table"
            and info.TypeC == "Normal" and info.TypeG == "BrutesDefeated"
            and sameWorld(info.World, island.order) then
            -- Prefer the own model; BaseInfo can resolve inherited brute variants.
            if matchesModel(info, models, enemyInfo, {}) then island.ids[id] = true end
        end
    end
end

local function buildLabels(island, enemyInfo)
    local counts = {}
    for id in pairs(island.ids) do
        local name = enemyInfo[id].Name
        name = type(name) == "string" and name ~= "" and name or id
        counts[name] = (counts[name] or 0) + 1
        table.insert(island.monsters, {id = id, name = name})
    end
    for _, monster in ipairs(island.monsters) do
        monster.label = counts[monster.name] > 1
            and (monster.name .. " [" .. monster.id .. "]") or monster.name
        island.byLabel[monster.label] = monster
    end
    table.sort(island.monsters, function(a, b)
        local left, right = a.name:lower(), b.name:lower()
        if left == right then return a.id < b.id end
        return left < right
    end)
end

function Catalog.build(mapInfo, enemyInfo, questsInfo, worldNumber)
    local catalog = {islands = {}, byKey = {}, byName = {}, byMapId = {}}
    local quests = type(questsInfo) == "table" and questsInfo.Normal
    quests = type(quests) == "table" and quests or {}
    for key, map in pairs(mapInfo) do
        local order = type(map) == "table" and tonumber(map.Order)
        if type(key) == "string" and order and order > 0 and order < math.huge
            and sameWorld(map.World, worldNumber) then
            local island = {
                key = key, name = type(map.Name) == "string" and map.Name or key,
                mapId = tostring(order), order = order,
                ids = {}, monsters = {}, byLabel = {},
            }
            addQuestEnemies(island, map, enemyInfo, quests)
            addBrutes(island, enemyInfo)
            buildLabels(island, enemyInfo)
            table.insert(catalog.islands, island)
            catalog.byKey[key] = island
            catalog.byName[island.name] = island
            catalog.byMapId[island.mapId] = island
        end
    end
    table.sort(catalog.islands, function(a, b)
        if a.order == b.order then return a.key < b.key end
        return a.order < b.order
    end)
    return catalog
end

-- Compare scientific HP without overflowing different large values to the same +inf.
function Catalog.healthKey(value)
    if type(value)~="number"and type(value)~="string"then return end
    if value==math.huge then return {math.huge,"1"}end
    local text=tostring(value):match("^%s*(.-)%s*$")
    local mantissa,exponent=text:match("^%+?([%d%.]+)[eE]([%+%-]?%d+)$")
    if not mantissa then mantissa=text:match("^%+?([%d%.]+)$")exponent="0"end
    if not mantissa then return end
    local integer,fraction=mantissa:match("^(%d*)%.(%d*)$")
    if not integer then integer=mantissa:match("^(%d+)$")fraction=""end
    if not integer then return end
    local digits=integer..fraction
    local first=digits:find("[1-9]")
    local exp=tonumber(exponent)
    if not first or not exp or exp~=exp then return end
    return {exp+#integer-first,(digits:sub(first):gsub("0+$",""))}
end
function Catalog.compareHealthKeys(a,b)
    if not a then return b and -1 or 0 end
    if not b then return 1 end
    if a[1]~=b[1]then return a[1]>b[1]and 1 or -1 end
    local length=math.max(#a[2],#b[2])
    local left=a[2]..string.rep("0",length-#a[2])
    local right=b[2]..string.rep("0",length-#b[2])
    return left==right and 0 or left>right and 1 or -1
end
function Catalog.matches(island,selected,attrs)
    if type(island)~="table"or type(attrs)~="table"then return false end
    local id=attrs.Id
    local chosen=type(selected)=="table"and selected[id]==true or type(selected)=="string"and selected==id
    if not chosen or not island.ids[id]or tostring(attrs.MapId)~=island.mapId
        or attrs.Dead==true or attrs.Shield==true then return false end
    return Catalog.healthKey(attrs.HP)~=nil
end

return Catalog
end)()

local Data=(function()
-- Live views over the game's current ClientData, with legacy Instance support.
local Data={}
Data.__index=Data
local Node={}
local function keyAt(t,key)
    if type(t)~="table"then return nil end
    local value=t[key]
    if value==nil and type(key)=="string"and tonumber(key)then value=t[tonumber(key)]end
    return value
end
function Data.new(player,client)
    if client==nil then
        local shared=game:GetService("ReplicatedStorage"):FindFirstChild("SharedModules")
        local module=shared and shared:FindFirstChild("ClientData")
        if module then
            local previous=type(getthreadidentity)=="function"and getthreadidentity()or nil
            if previous and type(setthreadidentity)=="function"then setthreadidentity(2)end
            local ok,result=pcall(require,module)
            if previous and type(setthreadidentity)=="function"then setthreadidentity(previous)end
            assert(ok,"Cannot load ClientData: "..tostring(result))client=result
        end
    end
    return setmetatable({player=player,client=client,nodes={}},Data)
end
function Data:raw(path)
    local value=self.client and self.client.GetData()
    for _,key in ipairs(path)do value=keyAt(value,key)end
    return value
end
function Data:isLoaded()
    if self.client then return self.client.IsLoaded()and type(self.client.GetData())=="table"end
    return self.player:GetAttribute("Loaded")==true
end
function Data:node(path)
    local id=table.concat(path,"\0")
    if not self.nodes[id]then self.nodes[id]=setmetatable({_owner=self,_path=table.clone(path)},Node)end
    return self.nodes[id]
end
function Data:stats()
    if self.client then return self:isLoaded()and self:node({})or nil end
    return self.player:FindFirstChild("leaderstats")
end
function Data:settings()
    if self.client then return type(self:raw({"Settings"}))=="table"and self:node({"Settings"})or nil end
    return self.player:FindFirstChild("Settings")
end
function Node:Raw()return self._owner:raw(self._path)end
function Node:GetAttribute(key)
    local value=self:Raw()
    if type(value)~="table"then return key=="Amount"and value or nil end
    return keyAt(value,key)
end
function Node:GetAttributes()
    local value=self:Raw()return type(value)=="table"and table.clone(value)or {}
end
function Node:SetAttribute(key,value)
    assert(self._path[1]=="Settings","Only temporary client Settings overrides are supported")
    local path=table.clone(self._path)table.insert(path,key)
    self._owner.client.SetLocal(path,value)
end
function Node:FindFirstChild(key)
    if keyAt(self:Raw(),key)==nil then return nil end
    local path=table.clone(self._path)table.insert(path,tostring(key))return self._owner:node(path)
end
function Node:GetChildren()
    local result={}
    local value=self:Raw()
    if type(value)=="table"then for key in pairs(value)do table.insert(result,self:FindFirstChild(key))end end
    return result
end
function Node:IsA(class)return class=="Folder"or class=="Instance"end
Node.__index=function(self,key)
    if Node[key]then return Node[key]end
    if key=="Name"then return tostring(self._path[#self._path]or "leaderstats")end
    if key=="Parent"then return self:Raw()~=nil and self._owner.player or nil end
    if key=="ChildAdded"then return {Connect=function(_,callback)
        local known={}for name in pairs(self:Raw()or {})do known[name]=true end
        return self._owner.client.OnChildChanged(self._path,function(name,value)
            local added=value~=nil and not known[name]known[name]=value~=nil or nil
            if added then callback(self:FindFirstChild(name))end
        end)
    end}end
    return self:FindFirstChild(key)
end
return Data
end)()

local Adapter=(function()
-- Game data, ground coordinates and observed native combat payloads.
local Adapter = {}
Adapter.__index = Adapter

local function gameCall(callback)
    local previous = type(getthreadidentity) == "function" and getthreadidentity() or nil
    if previous and type(setthreadidentity) == "function" then setthreadidentity(2) end
    local result = table.pack(pcall(callback))
    if previous and type(setthreadidentity) == "function" then setthreadidentity(previous) end
    if not result[1] then error(result[2], 2) end
    return table.unpack(result, 2, result.n)
end

function Adapter.new()
    local self = setmetatable({}, Adapter)
    self.players = game:GetService("Players")
    self.rs = game:GetService("ReplicatedStorage")
    self.player = self.players.LocalPlayer
    self.data=Data.new(self.player)
    self.main = assert(workspace:WaitForChild("__Main", 10), "World is not loaded")
    local enemies = assert(self.main:WaitForChild("__Enemies", 10), "Enemies are not loaded")
    self.enemies = assert(enemies:WaitForChild("Server", 10), "Enemy state is not loaded")
    local extra = workspace:WaitForChild("__Extra", 10)
    self.spawns = extra and extra:FindFirstChild("__Spawns")
    local indexer = self.rs:WaitForChild("Indexer", 10)
    gameCall(function()
        self.mapInfo = require(indexer.MapInfo)
        self.enemyInfo = require(indexer.EnemyInfo)
        self.questsInfo = require(indexer.QuestsInfo)
        local bridges = require(self.rs.BridgeNet2)
        self.bridge = bridges.ReferenceBridge("ENEMY_EVENT")
        self.generalBridge = bridges.ReferenceBridge("GENERAL_EVENT")
        self.dungeonBridge = bridges.ReferenceBridge("DUNGEON_EVENT")
        self.basicInfo = require(indexer.BasicInfos)
        self.balanceInfo = require(indexer.BalanceInfo)
        self.dungeonInfo = require(indexer.DungeonInfo)
        self.castleInfo = require(indexer.CastleInfo)
        self.mountInfo = require(indexer.MountsInfo)
        self.testInfo = require(indexer.DgTestInfo)
        self.petInfo = require(indexer.PetsInfo)
        self.damageFunctions = require(self.rs.SharedModules.DamageFunctions)
        self.shadowBridge = bridges.ReferenceBridge("PET_EVENT")
        self.cooldowns = require(self.rs.SharedModules.CooldownModule)
        self.extras = require(self.rs.SharedModules.ExtraFunctions)
        self.pets = require(self.rs.SharedModules.PetsService)
        self.petController = require(self.rs.SharedModules.Pets.PetsController)
    end)
    self.floorParams = RaycastParams.new()
    self.floorParams.FilterType = Enum.RaycastFilterType.Include
    self.floorParams.IgnoreWater = true
    self.floorParams.RespectCanCollide = true
    local geometry = self.main:WaitForChild("__World", 10)
    local floorRoots = {workspace.Terrain}
    if geometry then table.insert(floorRoots, geometry) end
    local dungeonGeometry = self.main:FindFirstChild("__Dungeon")
    if dungeonGeometry then table.insert(floorRoots, dungeonGeometry) end
    self.floorParams.FilterDescendantsInstances = floorRoots
    self.world = tonumber(self.rs:GetAttribute("World")) or tonumber(getgenv().__SenzyDungeonWorld) or 1
    self.range, self.interval, self.nextStats = 30, 0.45, 0
    return self
end

function Adapter:getStats()return self.data:stats()end
function Adapter:getSettings()return self.data:settings()end

function Adapter:hasShadowSpace()
    local stats=self:getStats()
    local inventory=stats and stats:FindFirstChild("Inventory")
    local pets=inventory and inventory:FindFirstChild("Pets")
    if not pets then return false end
    local capacity=gameCall(function()return tonumber(self.extras.GetTotalPets(self.player))end)
    return capacity~=nil and #pets:GetChildren()<capacity
end

function Adapter:bestPetCandidates(pets,equipped,makeKey)
    return gameCall(function()
        local maximum=tonumber(self.extras.GetMaxPets(self.player))or 0
        local candidates={}
        for _,pet in ipairs(pets:GetChildren())do
            local info=self.petInfo[pet:GetAttribute("Name")]
            if info and pet:GetAttribute("InExp")~=true and pet:FindFirstChild("Stats")then
                local record=self.data.client and pet:Raw()or pet
                local damage=self.damageFunctions.GetPetDamage(self.player,info,record,nil,nil,true)
                local key=makeKey(damage)
                if key then table.insert(candidates,{id=pet.Name,damage=key,equipped=equipped[pet.Name]==true})end
            end
        end
        return candidates,math.max(0,math.floor(maximum))
    end)
end

function Adapter:character()
    local character = self.player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if root and humanoid and humanoid.Health > 0 then return character, root, humanoid end
end

function Adapter:blocked(forDungeon)
    local world = tonumber(self.rs:GetAttribute("World"))
    if not forDungeon and self.rs:GetAttribute("Dungeon") ~= true and world and world ~= self.world then return "World changed - reload this script" end
    if self.player:GetAttribute("Mounted") == true then return "Dismount before farming" end
    if self.player:GetAttribute("Teleporting") == true then return "Waiting for teleport" end
    if self.player:GetAttribute("InBossRush") or self.player:GetAttribute("InTimeTrial")
        or (not forDungeon and self.rs:GetAttribute("Dungeon") == true) then return "Return to the main world" end
    local character = self.player.Character
    if character and character:GetAttribute("InTp") then return "Waiting for teleport" end
end

function Adapter:refreshStats(now)
    if now < self.nextStats then return end
    self.nextStats = now + 10
    gameCall(function()
        self.range = tonumber(self.pets:GetRange(self.player)) or 30
        local talent = self.extras.FindTalent(self.player, "AttackSpeed")
        self.interval = math.max(0.4 * (tonumber(talent) or 1), 0.1) + 0.05
    end)
end

function Adapter:enemyAlive(enemy)
    return enemy~=nil and enemy.Parent==self.enemies and enemy:IsA("BasePart")
        and enemy:GetAttribute("Dead")~=true and Catalog.healthKey(enemy:GetAttribute("HP"))~=nil
end

function Adapter:isTarget(enemy, island, enemyId, catalogModule)
    return enemy ~= nil and enemy.Parent == self.enemies and enemy:IsA("BasePart")
        and catalogModule.matches(island, enemyId, enemy:GetAttributes())
end

function Adapter:nearest(island, enemyId, position, catalogModule)
    local nearest, distance = nil, math.huge
    for _, enemy in ipairs(self.enemies:GetChildren()) do
        if self:isTarget(enemy, island, enemyId, catalogModule) then
            local current = (enemy.Position - position).Magnitude
            if current < distance then nearest, distance = enemy, current end
        end
    end
    return nearest, distance
end

function Adapter:highestHealth(island,selectedIds,position,catalogModule,currentTarget,visited)
    local best,bestHP,bestDistance=nil,nil,math.huge
    for _,enemy in ipairs(self.enemies:GetChildren())do
        if enemy:IsA("BasePart")then
            local attrs=enemy:GetAttributes()
            if catalogModule.matches(island,selectedIds,attrs)and not(visited and visited[enemy])then
                local hp=catalogModule.healthKey(attrs.HP)
                local distance=(enemy.Position-position).Magnitude
                local compare=catalogModule.compareHealthKeys(hp,bestHP)
                if compare>0 or compare==0 and (enemy==currentTarget
                    or best~=currentTarget and distance<bestDistance)then
                    best,bestHP,bestDistance=enemy,hp,distance
                end
            end
        end
    end
    return best
end

function Adapter:randomTarget(island,selected,catalogModule,visited,choose)
    local target,count=nil,0
    for _,enemy in ipairs(self.enemies:GetChildren())do
        if self:isTarget(enemy,island,selected,catalogModule)and not(visited and visited[enemy])then
            count+=1
            if(choose or math.random)(count)==1 then target=enemy end
        end
    end
    return target
end

function Adapter:armyNear(root)
    if self.player:GetAttribute("PetsArise")~=true then return true,0,0 end
    local army=gameCall(function()return self.petController.GetPlayerPets(self.player)end)
    local total,near=0,0
    local radius=math.max(12,math.min(self.range or 30,25))
    for _,pet in pairs(army or {})do
        if pet.PetFolder and pet.PetFolder.Parent and typeof(pet._currentCFrame)=="CFrame"then
            total+=1
            if(pet._currentCFrame.Position-root.Position).Magnitude<=radius then near+=1 end
        end
    end
    return total==0 or near==total,near,total
end

function Adapter:standingHeight(character, root, humanoid)
    local height = root.Size.Y * 0.5 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
        if leg and leg:IsA("BasePart") then height += leg.Size.Y end
    end
    return height
end

function Adapter:groundAt(position, rise, drop)
    local hit = workspace:Raycast(position + Vector3.new(0, rise or 2, 0),
        Vector3.new(0, -(drop or 128), 0), self.floorParams)
    if hit and hit.Normal.Y >= 0.45 then return hit.Position end
end

function Adapter:targetPosition(enemy, character, root, humanoid, now)
    if enemy and enemy.Parent==self.enemies and enemy:IsA("BasePart")then return enemy.Position end
    local cache = self.floorCache
    if cache and cache.enemy == enemy and cache.character == character and now < cache.expires
        and (cache.enemyPosition - enemy.Position).Magnitude < 1 then
        return cache.goal
    end
    local floor = self:groundAt(enemy.Position)
    local goal = floor and Vector3.new(enemy.Position.X,
        floor.Y + self:standingHeight(character, root, humanoid), enemy.Position.Z)
    self.floorCache = {enemy=enemy, character=character, enemyPosition=enemy.Position, goal=goal, expires=now+0.1}
    return goal
end

function Adapter:spawnPosition(island, character, root, humanoid)
    local spawn = self.spawns and self.spawns:FindFirstChild(island.key)
    if not spawn or not spawn:IsA("BasePart") then return nil end
    local floor = self:groundAt(spawn.Position)
    local surfaceY = floor and floor.Y or spawn.Position.Y + spawn.Size.Y * 0.5
    return Vector3.new(spawn.Position.X, surfaceY + self:standingHeight(character, root, humanoid), spawn.Position.Z)
end

function Adapter:attack(enemy, root, now)
    if now < (self.nextAttack or 0) then return false end
    if (enemy.Position - root.Position).Magnitude > math.min(self.range, 25) then return false end
    if not self.cooldowns.Verify("Punch", self.interval) then return false end
    self.nextAttack = now + self.interval
    self.cooldowns.Add("Punch")
    self.bridge:Fire({Event = "PunchAttack", Enemy = enemy.Name})
    return true
end

return Adapter
end)()

local Movement=(function()
-- Model PivotTo warps, paced like the supplied reference. No persistent physics controller.
local Movement={}
Movement.__index=Movement
local WARP_INTERVAL=1.2
function Movement.new(adapter)
    return setmetatable({adapter=adapter,corrections=0,tpDelay=1,nextEnemyAt=0,nextWarpAt=0},Movement)
end
function Movement:stop()
    self.character,self.root,self.humanoid=nil,nil,nil
    self.expected,self.sentAt,self.key,self.landedEnemy=nil,nil,nil,nil
    -- Keep the shared warp cooldown and post-kill delay across target / owner changes.
end
function Movement:attach(character,root,humanoid)
    if self.root==root and self.character==character then return end
    self:stop()
    self.character,self.root,self.humanoid=character,root,humanoid
end
local function upright(position,lookAt,root)
    local direction=Vector3.new(lookAt.X-position.X,0,lookAt.Z-position.Z)
    if direction.Magnitude<0.05 then
        local old=root.CFrame.LookVector
        direction=Vector3.new(old.X,0,old.Z)
    end
    if direction.Magnitude<0.05 then direction=Vector3.new(0,0,-1)end
    return CFrame.lookAt(position,position+direction.Unit)
end
function Movement:waitAfterEnemy(now)
    self.nextEnemyAt=now+math.clamp(tonumber(self.tpDelay)or 1,0,10)
end
function Movement:waitingForEnemy(now)
    return now<(self.nextEnemyAt or 0)
end
function Movement:step(character,root,humanoid,goal,lookAt,mode,speed,key,dt,now)
    self:attach(character,root,humanoid)
    if self.corrections>=3 then return false,"Movement was reset repeatedly - farm stopped"end
    if not character.Parent or not root.Parent or humanoid.Health<=0 or root.Anchored then return false end
    local enemy=typeof(key)=="Instance"and key:IsA("BasePart")and key.Parent==self.adapter.enemies
    if enemy then
        if not self.adapter:enemyAlive(key)then return false,"Waiting for a live target"end
        goal=key.Position
    end
    if typeof(goal)~="Vector3"then return false,"Waiting for a destination"end
    local position=root.Position
    if self.expected then
        if(position-self.expected).Magnitude>60 then
            self.corrections+=1 self.expected=nil self.sentAt=nil self.landedEnemy=nil
            self.nextWarpAt=math.max(self.nextWarpAt,now+WARP_INTERVAL)
            if self.corrections>=3 then return false,"Movement was reset repeatedly - farm stopped"end
            return false,"Position changed - waiting before retry"
        elseif now-(self.sentAt or now)>=WARP_INTERVAL then self.expected=nil self.sentAt=nil end
    end
    if enemy and self.landedEnemy==key and(position-goal).Magnitude<=math.min(self.adapter.range or 30,25)then return true end
    if(position-goal).Magnitude<=0.8 then
        self.landedEnemy=enemy and key or nil
        return enemy or humanoid.FloorMaterial~=Enum.Material.Air
    end
    if enemy and self:waitingForEnemy(now)then return false,"Waiting after target death"end
    if now<self.nextWarpAt then return false end
    local destination=enemy and key.CFrame or upright(goal,lookAt or goal,root)
    -- Model pivots can differ from the root's frame. Preserve that offset so HRP lands exactly on the target.
    local rootToPivot=root.CFrame:ToObjectSpace(character:GetPivot())
    character:PivotTo(destination*rootToPivot)
    self.nextWarpAt=now+WARP_INTERVAL
    self.expected,self.sentAt,self.key=goal,now,key
    self.landedEnemy=enemy and key or nil
    return false
end
return Movement
end)()

local ShadowFollow=(function()
-- Native ShowPets transport. Never changes shadow positions or attack targets locally.
local ShadowFollow={}
ShadowFollow.__index=ShadowFollow
function ShadowFollow.new(app)
    return setmetatable({app=app,adapter=app.adapter,stage="idle",nextTry=0,lastSent=-math.huge,alive=true},ShadowFollow)
end
function ShadowFollow:busy()return self.stage~="idle"end
function ShadowFollow:send(now)
    self.lastSent=now self.adapter.shadowBridge:Fire({Event="ShowPets"})
end
function ShadowFollow:finish(now)
    self.stage="idle"self.key=nil self.character=nil self.awaitHide=false self.nextTry=now+6
end
function ShadowFollow:cancel(now)
    if self.stage=="idle"or self.stage=="recover"then return end
    self.awaitHide=self.stage=="hide"
    local sent=(self.stage=="show"or self.stage=="verify")and self.restoreSent==true
    self.stage="recover"self.deadline=now+8 self.restoreSent=sent
end
function ShadowFollow:tick(now)
    if not self.alive or self.stage=="idle"then return end
    local shown=self.adapter.player:GetAttribute("PetsArise")
    local character,root=self.adapter:character()
    if self.stage~="recover"and character~=self.character then self:cancel(now)end
    if self.stage=="hide"then
        if shown==false then self.stage="move"self.deadline=now+12
        elseif now>=self.deadline then self:cancel(now)end
    elseif self.stage=="move"then
        if now>=self.deadline then self:cancel(now)end
    elseif self.stage=="show"then
        if shown==true then self.stage="verify"self.deadline=now+4
        elseif shown==false and not self.restoreSent and now-self.lastSent>=3 then self.restoreSent=true self:send(now)
        elseif now>=self.deadline then self:cancel(now)end
    elseif self.stage=="verify"then
        if shown==false then self:cancel(now)
        elseif root then
            local ready,_,count=self.adapter:armyNear(root)
            if ready and count>0 or now>=self.deadline then self:finish(now)end
        elseif now>=self.deadline then self:finish(now)end
    elseif self.stage=="recover"then
        if shown==true and(not self.awaitHide or now-self.lastSent>=5)then self:finish(now)
        elseif shown==false and character and not self.restoreSent and now-self.lastSent>=3 then self.restoreSent=true self.awaitHide=false self:send(now)
        elseif now>=self.deadline then
            self.app:stopAll("Shadow summon was not confirmed - check ARISE")
            self:finish(now)
        end
    end
end
function ShadowFollow:beforeMove(key,character,root,goal,now)
    if self:busy()and self.key~=key then self:cancel(now)end
    self:tick(now)
    if self.stage=="hide"or self.stage=="recover"then return false,"Waiting for shadow state"end
    if self:busy()then return true end
    if now<self.nextTry or self.adapter.player:GetAttribute("PetsArise")~=true then return true end
    local ready,_,count=self.adapter:armyNear(root)
    if count==0 or ready and(root.Position-goal).Magnitude<=40 then return true end
    self.key=key self.character=character self.stage="hide"self.deadline=now+5 self.restoreSent=false
    self:send(now)
    return false,"Storing shadows before warp"
end
function ShadowFollow:afterMove(arrived,now)
    if not arrived then return false end
    if self.stage=="move"then
        self.stage="show"self.deadline=now+8 self.restoreSent=false
        self:tick(now)
    end
    return self.stage=="idle"
end
function ShadowFollow:Destroy()
    if not self.alive then return end
    local restore=self:busy()
    local wasStage=self.stage
    self.alive=false self.stage="idle"
    if not restore then return end
    local adapter=self.adapter local lastSent=self.lastSent
    local pendingHide=self.awaitHide or wasStage=="hide"
    local showSent=self.restoreSent==true
    task.spawn(function()
        local deadline=os.clock()+8
        while os.clock()<deadline do
            local current=getgenv().SenzyAriseFarm
            if current and current~=self.app and current.shadowFollow and current.shadowFollow:busy()then return end
            local shown=adapter.player:GetAttribute("PetsArise")
            if shown==true and(not pendingHide or os.clock()-lastSent>=5)then return end
            if shown==false and not showSent and os.clock()-lastSent>=3 then adapter.shadowBridge:Fire({Event="ShowPets"})return end
            task.wait(.2)
        end
    end)
end
return ShadowFollow
end)()

local Controller=(function()
-- Random coverage of selected enemies; keep the chosen living target until death or invalidation.
local Controller = {}
