    if not module then return false end
    return gameCall(function()
        local buttons = require(module)
        if type(buttons.HLRaidButtons) ~= "function" then return false end
        if self.app then self.app:acquireRuntime(self.app.currentWorker) end
        if self.app then
            self.app.entryIntent={owner=self.app.currentWorker,expires=os.clock()+45}
            self.app.frameDispatched=true
        end
        buttons.HLRaidButtons(nil, {Action = "Join", Check = false})
        return true
    end)
end
