        local best, bestScore
        for _, pumpkin in ipairs(folder:GetChildren()) do
            if self:available(pumpkin, now) then
                local part = self:part(pumpkin)
                local island = self:islandFor(pumpkin, part)
                if not next(self.selectedIslands) or island and self.selectedIslands[island.key] then
