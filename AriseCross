        local ok,handled=pcall(owner.step,owner,dt)
        self.currentWorker=nil
        if not ok then
            owner:setEnabled(false)owner.status="Event stopped: "..tostring(handled)
            warn("[senzy hub] "..owner.status)
        end
        if ok and handled==true then return true end
        ready[owner]=false release(owner)owner=nil
        if handoffCastle()then return true end
    end
    return false
end


function Controller:step(dt)
    if not self.alive then return end
    self.frameDispatched=false self.currentWorker=nil
    if self.shadowFollow then self.shadowFollow:tick(os.clock())end
    if self.dash then self.dash:step(os.clock())end
    if self:modeStep(dt)then return end
    if self:eventStep(dt)then return end
    self.currentWorker=self
    if self.clickEnabled then self:clickStep(os.clock()) end
    if not self:isActive() and not self.autoSetSpawn then return end
    local adapter = self.adapter
    local blocked = adapter:blocked()
    if blocked then self:invalidate() self.status=blocked return end
    local character, root, humanoid = adapter:character()
    if not character then self:invalidate() self.status="Waiting for your character" return end
    if self.character ~= character then
        self:invalidate()
        self.character = character
    end
    local now = os.clock()
    if self.target and not adapter:enemyAlive(self.target)then
        if self.target.Parent==adapter.enemies then self.visited[self.target]=true end
        self:invalidate()self.movement:waitAfterEnemy(now)
    elseif self.target and not adapter:isTarget(self.target,self.island,self.selectedIds,self.catalogModule)then
        -- An alive target can become shielded or change eligibility after selection.
        self:invalidate()
    end
    if not self.target and self.movement:waitingForEnemy(now)then
        self.movement:stop()self.status="Waiting after target death"return
    end
    if self.autoSetSpawn and not(self.target and adapter:enemyAlive(self.target))
        and self:spawnStep(character,root,humanoid,dt,now)then return end
    if not self:isActive()then return end
    local island, enemyId = self.island, self.selectedIds
    if not self:selectionReady() then self:stopAll("Select an island and monster") return end
    if not self.target and now>=self.nextSearch then
        self.nextSearch=now+0.1
        for enemy in pairs(self.visited)do if not enemy.Parent then self.visited[enemy]=nil end end
        local best=adapter:randomTarget(island,enemyId,self.catalogModule,self.visited)
        if not best and next(self.visited)then
            self.visited={}
            best=adapter:randomTarget(island,enemyId,self.catalogModule)
        end
        if best~=self.target then
            self.target=best self.generation+=1
            self.movement:stop()
        end
    end
    local target, goal, lookAt, key = self.target
    local info=target and adapter.enemyInfo[target:GetAttribute("Id")]
    local targetName=info and info.Name or "selected monsters"
    if target then
        if not adapter:isTarget(target,island,enemyId,self.catalogModule)then
            self.movement:stop()self.status="Waiting for the current target"return
        end
        goal = adapter:targetPosition(target,character,root,humanoid,now)
        if not goal then
            self.movement:stop()
            self.status = "Waiting for ground under the selected monster"
            return
        end
        lookAt, key = target.Position, target
    else
        local present = false
        for _, enemy in ipairs(adapter:enemyList()) do
            if tostring(enemy:GetAttribute("MapId")) == island.mapId then present=true break end
        end
        local spawn = adapter:spawnPosition(island,character,root,humanoid)
        local nearIsland = spawn and (root.Position-spawn).Magnitude < 1800
        if present and nearIsland then
            self.movement:stop()
            self.status = "Waiting for " .. targetName
            return
        end
        goal = spawn
        if not goal then self.movement:stop() self.status="Island spawn is unavailable" return end
        if (root.Position-goal).Magnitude < 15 then
            self.movement:stop()
            self.status="Waiting for island monsters to load"
            return
        end
        lookAt, key = goal+Vector3.new(0,0,-1), island.key
    end
    if target and self.shadowFollow then
        local ready,reason=self.shadowFollow:beforeMove(target,character,root,goal,now)
        if not ready then self.movement:stop()self.status=reason return end
    end
    local arrived, message = self.movement:step(character,root,humanoid,goal,lookAt,
        self.mode,self.speed,key,dt,now)
    if message then
        if self.movement.corrections >= 3 then self:stopAll(message) else self.status=message end
        return
    end
    if not arrived then
        self.status = "Moving to "
            .. (target and targetName or island.name)
        return
    end
    if target and self.shadowFollow and not self.shadowFollow:afterMove(true,now)then
        self.status="Summoning shadows at target"return
    end
    if not target then self.status="Waiting for island monsters to load" return end
    self.status = "Farming " .. targetName .. " | HP " .. tostring(adapter:enemyHP(target))
    -- All operations below are non-yielding; never use a delayed task with an old target.
    if not self:isActive() or self.target ~= target
        or not adapter:isTarget(target,island,enemyId,self.catalogModule) then return end
    if self.enabled and adapter:isTarget(target,island,enemyId,self.catalogModule) then
        if adapter:attack(target,root,now) then self.requests += 1 end
    end
end

function Controller:start()
    local runService = game:GetService("RunService")
    local busy = false
    table.insert(self.connections,runService.Heartbeat:Connect(function(dt)
        if busy or not self.alive then return end
        busy = true
        local ok,err = pcall(self.step,self,dt)
        busy = false
        if not ok then
            self:setClickEnabled(false)
            if self.onClickStopped then self.onClickStopped() end
            self:stopAll("Farm stopped: " .. tostring(err))
            warn("[senzy hub] " .. tostring(err))
        end
    end))
    table.insert(self.connections,self.adapter.player.CharacterAdded:Connect(function()
        self:invalidate()
        self.movement.corrections = 0
        self.character = nil
    end))
    task.spawn(function()
