    local controls = selection
    local monsterDropdown, islandDropdown, toggle, spawnToggle
    local updating = false
    local function refreshMonsters()
        if not monsterDropdown then return end
        updating=true
        local options,active={},{}
        if app.island then for _,m in ipairs(app.island.monsters)do
            table.insert(options,m.label)
            if app.selectedIds[m.id]then table.insert(active,m.label)end
        end end
        monsterDropdown:ClearOptions()monsterDropdown:InsertOptions(options)
        monsterDropdown:UpdateSelection(active)monsterDropdown:SetVisibility(true)
        updating=false
    end
    local function selected(dropdown)
        if not dropdown then return nil end
        for name, active in pairs(dropdown:GetOptions()) do if active then return name end end
    end
    local function stopToggle()
        if toggle and toggle:GetState() then toggle:UpdateState(false) end
    end
    app.onStopped = function()
        stopToggle()
        if spawnToggle and not app.autoSetSpawn and spawnToggle:GetState()then spawnToggle:UpdateState(false)end
    end
    local names = {}
    for _, island in ipairs(app.catalog.islands) do table.insert(names, island.name) end
    islandDropdown = selection:Dropdown({
        Name = "Island", Options = names, Required = false, Search = true,
        Callback = function(value)
            if not app.alive or updating or not islandDropdown then return end
            value = selected(islandDropdown)
            if app.island~=app.catalog.byName[value]then
                app:selectIsland(value)
                stopToggle()
            end
            refreshMonsters()
        end,
    }, "SenzyAriseIsland")
    monsterDropdown = selection:Dropdown({
