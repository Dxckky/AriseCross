function Config.guardGroup(app,native)
    local function proxy(object,kind)
        return setmetatable({},{__index=function(_,key)
            local method=object[key]
            if type(method)~="function"then return method end
            if key=="Tab"or key=="Section"then
                return function(_,...)return proxy(method(object,...),key)end
            end
            if kind=="Section"and(key=="Toggle"or key=="Dropdown"or key=="Slider"or key=="Input"or key=="Button")then
                return function(_,settings,...)
                    local config=table.clone(settings)
                    local callback=config.Callback
                    if type(callback)=="function"then config.Callback=function(...)
                        if not app.alive or app.restoringConfig then return end
                        local values=table.pack(callback(...))
                        if app.config then app.config:changed(key=="Toggle"or key=="Dropdown")end
                        return table.unpack(values,1,values.n)
                    end end
                    return method(object,config,...)
                end
            end
            return function(_,...)return method(object,...)end
        end})
    end
