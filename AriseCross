        if type(worker.stop) == "function" then worker:stop("Stopped: " .. tostring(result))
        elseif type(worker.setEnabled) == "function" then worker:setEnabled(false) end
        warn("[senzy hub] Worker error: " .. tostring(result))
    end
    if self.frameDispatched or ok and result == true then return true end
